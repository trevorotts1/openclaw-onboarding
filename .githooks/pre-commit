#!/bin/bash
# Pre-commit hook: version consistency + fleet QC invariants.
#
# This hook ONLY executes on clones where scripts/install-git-hooks.sh has been
# run (core.hooksPath is per-clone local configuration and is not committable).
# Without the installer, this file sits inert — run it once per clone.
#
# Gates (all hard-fail, block the commit — listed here in file order 1,2,3,4,6,7,9,5,8):
#   1. Client-name guard (CRITICAL — fleet privacy rule, no real names in template)
#   2. WhatsApp fleet ban (FLEET-STANDARDS.md §3 — enabled:true or uncommented WHATSAPP_NUMBER=)
#   3. N28 no destructive cron payloads (rm -rf on install paths / npm uninstall -g openclaw)
#   4. chmod-600 coverage on .sh files that write secrets/.env
#   6. agent-browser singleton gateway (no raw launch outside browser_manager;
#      teardown+lock+breaker present; sentinel present) — on staged 06-* changes
#   7. Persona-set count triad (repo library <-> manifest lockstep)
#   9. universal-sops content-manifest freshness (sha256 lockstep) — on staged
#      universal-sops/** changes
#   5. Version consistency (version / install.sh / CHANGELOG.md)
#  10. Presentations SOP lockstep (SOP-SLIDE-06 gate 2 / FIX 36 — sync_check.py
#      blocks on drift when a Presentations role .md, dept sops/, the manifest, or
#      build_deck.py is staged; exit 4 drift and exit 2 cannot-run both block)
#   8. Full env dump guard (pm2 jlist/prettylist/--json) — WARN-MODE only (Rule 3.5 stage 1)

# ── 0. Locate repo root ──────────────────────────────────────────────────────
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT" || exit 1

# ── 1. Client-name guard (CRITICAL) ─────────────────────────────────────────
if [ -f "scripts/qc-assert-no-client-names.sh" ]; then
  # QC_GATE_CONTEXT: the gate's own durable audit log (outside the repo)
  # records this run against HEAD — the parent commit this new commit will
  # be based on, since the new commit's own SHA does not exist yet.
  if ! QC_GATE_CONTEXT="pre-commit:$(git rev-parse HEAD 2>/dev/null || echo 'no-parent-commit')" \
      bash scripts/qc-assert-no-client-names.sh; then
    echo ""
    echo "PRE-COMMIT BLOCKED: real client names detected in tracked files."
    echo "Replace each with a generic placeholder (see output above)."
    exit 1
  fi
fi

# ── 2. WhatsApp fleet ban ────────────────────────────────────────────────────
WA_FAIL=0
# Staged .json files — check plugins.entries.whatsapp.enabled
while IFS= read -r f; do
  [ -f "$f" ] || continue
  if ! python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    enabled = d.get('plugins',{}).get('entries',{}).get('whatsapp',{}).get('enabled',False)
    sys.exit(1 if enabled else 0)
except Exception: sys.exit(0)
" "$f" 2>/dev/null; then
    echo "PRE-COMMIT BLOCKED: $f has plugins.entries.whatsapp.enabled=true (FLEET-STANDARDS.md §3)"
    WA_FAIL=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.json$')
# Staged .env files — check for uncommented WHATSAPP_NUMBER=
while IFS= read -r f; do
  [ -f "$f" ] || continue
  if grep -qE '^[[:space:]]*WHATSAPP_NUMBER[[:space:]]*=[^#]' "$f" 2>/dev/null; then
    echo "PRE-COMMIT BLOCKED: $f has uncommented WHATSAPP_NUMBER= (FLEET-STANDARDS.md §3)"
    WA_FAIL=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -E '(^|/)\.env$|\.env$')
[ "$WA_FAIL" -eq 1 ] && exit 1

# ── 3. N28 — no destructive cron payloads ───────────────────────────────────
N28_FAIL=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  # rm -rf on OpenClaw install paths
  if grep -E 'rm[[:space:]]+-rf[[:space:]].*(\~/.openclaw|~/clawd|\$HOME/.openclaw|\$HOME/clawd|/data/.openclaw)' "$f" 2>/dev/null \
      | grep -v '^[[:space:]]*#' | grep -q .; then
    echo "PRE-COMMIT BLOCKED: $f has rm -rf on an OpenClaw install path (N28 violation)"
    N28_FAIL=1
  fi
  # npm uninstall -g openclaw
  if grep -E 'npm[[:space:]]+uninstall[[:space:]]+-g[[:space:]]+openclaw' "$f" 2>/dev/null \
      | grep -v '^[[:space:]]*#' | grep -q .; then
    echo "PRE-COMMIT BLOCKED: $f has npm uninstall -g openclaw (N28 violation)"
    N28_FAIL=1
  fi
  # brew uninstall fleet components
  if grep -E 'brew[[:space:]]+uninstall[[:space:]]+(openclaw|cloudflared)' "$f" 2>/dev/null \
      | grep -v '^[[:space:]]*#' | grep -q .; then
    echo "PRE-COMMIT BLOCKED: $f has brew uninstall of a fleet component (N28 violation)"
    N28_FAIL=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.sh$')
[ "$N28_FAIL" -eq 1 ] && exit 1

# ── 4. chmod-600 coverage on secrets/.env writers ───────────────────────────
# v2 (2026-07-30): closed the "comment bypass" -- the old check here was a
# raw `grep -E 'chmod[[:space:]]+600'` over the WHOLE file, so a script
# could satisfy this gate with nothing but `# remember to chmod 600` (or
# the text sitting inert inside a heredoc body) and never actually secure
# the file. scripts/qc-assert-chmod600-real.py strips comments and heredoc
# bodies before searching for a real chmod 600 invocation -- see that
# script's docstring for exactly what it does and does not catch.
#
# v3 (2026-07-30): narrowed the TRIGGER itself. Through v2 the trigger was
# `grep -qE '(secrets/\.env|SECRETS_ENV_FILE)' "$f"` -- a blanket MENTION
# match that fired on any script that merely read, sourced, or QC-asserted
# the file, not just ones that wrote it. An audit found 98 .sh files
# matching that mention, 62 of them blocked, and only 3 were genuine
# writers -- the other 59 (read-only sourcing, credential-presence checks,
# QC assertions, dead `resolve_platform_paths()` boilerplate, doc/test
# text) were false positives. This silently froze scripts/update-skills.sh
# at v21.4.2 for 14 releases with no visible error -- the commit just
# never happened. `--is-write-reference` (same script) replaces the
# mention-grep with a check for an actual write-like construct (`>`,
# `>>`, `tee`, `touch`, `cp`, `mv`, `sed -i`) targeting the secrets file,
# by name or literal path -- see that flag's section in the script for
# the full design and its stated limitations.
C600_FAIL=0
while IFS= read -r f; do
  [ -f "$f" ] || continue
  if python3 "$REPO_ROOT/scripts/qc-assert-chmod600-real.py" --is-write-reference "$f" 2>/dev/null; then
    if ! python3 "$REPO_ROOT/scripts/qc-assert-chmod600-real.py" "$f" 2>/dev/null; then
      echo "PRE-COMMIT BLOCKED: $f writes to the secrets file (a redirection/touch/cp/mv/tee/sed-i targets a variable or literal path naming secrets/.env) but has no real chmod 600 call (token exposure risk -- a chmod 600 mentioned only in a comment or heredoc does not count)"
      C600_FAIL=1
    fi
  fi
done < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '\.sh$')
[ "$C600_FAIL" -eq 1 ] && exit 1

# ── 8. Full env dump guard (warn-mode) ─────────────────────────────────────────
# Detects pm2 jlist / pm2 prettylist / pm2 --json and the Python list-form
# equivalent in staged files. Ledger incidents: skill6-blended-persona-
# kanban-v2-2026-07-13.md:78 and skill58-podbean-proxy-2026-07-16.md:452.
# WARN-MODE ONLY — does not block the commit (Rule 3.5 stage 1).
# core.hooksPath is blank on this clone — the hook is advisory here.
if [ -f "scripts/qc-assert-no-full-env-dump.py" ]; then
  if git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
      | grep -qE '\.(sh|py|md|json)$'; then
    if ! python3 scripts/qc-assert-no-full-env-dump.py --report-json 2>/dev/null \
        | python3 -c "import json,sys; d=json.load(sys.stdin); v=d.get('violations',0); sys.exit(0 if v==0 else 1)"; then
      echo ""
      echo "WARNING: Full env dump (pm2 jlist/prettylist/--json) detected in staged files."
      echo "Reference: 61-loop-protection-system/scripts/loop_common.py:164-172 (filter_pm2_record)."
      echo "Report presence by name only, never value. Never capture a full process list"
      echo "into a shell variable. This is warn-mode (Rule 3.5 stage 1); not blocking."
      echo ""
    fi
  fi
fi

# ── 6. agent-browser singleton gateway (on staged 06-* / gateway changes) ─────
# SINGLETON POOLED BROWSER — one session, lock=1, TTL, guaranteed teardown,
# reaper backstop. If any staged change touches Skill 06 or the gateway/reaper/
# guard scripts, run the static guard and hard-fail on a regression (raw
# agent-browser launch outside browser_manager.sh, lost teardown/lock/breaker,
# per-iteration session name in a doc, or a missing doctrine sentinel).
if [ -f "scripts/guard-agent-browser-managed.sh" ]; then
  if git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
      | grep -Eq '^(06-ghl-install-pages/|scripts/agent-browser-reaper\.sh|scripts/guard-agent-browser-managed\.sh)'; then
    if ! bash scripts/guard-agent-browser-managed.sh; then
      echo ""
      echo "PRE-COMMIT BLOCKED: agent-browser singleton gateway regression (see output above)."
      echo "Route every agent-browser call through tools/browser_manager.sh; keep its"
      echo "teardown trap + lock + close/state-clear + circuit-breaker; never invent a"
      echo "per-iteration session name; restore the doctrine sentinel to the docs."
      exit 1
    fi
  fi
fi

# ── 8. -type f census guard (warn-mode) ───────────────────────────────────────
if [ -f "scripts/qc-assert-no-type-f-census.py" ]; then
  if ! python3 scripts/qc-assert-no-type-f-census.py; then
    # warn-mode always exits 0; this block is here so that when --enforce
    # is wired in a later unit, the hook blocks the commit.
    echo ""
    echo "WARNING: -type f without companion -type l detected."
    echo "A census must enumerate symlinks too. Use \\( -type f -o -type l \\)."
    echo "See output above for the violation list."
  fi
fi

# ── 7. Persona-set count triad (repo library <-> manifest lockstep) ──────────
# When any persona artifact is staged, the N38 count triad MUST agree in the
# working tree: blueprint dirs == persona-categories.json keys ==
# INDEX-MANIFEST persona_count == canonical_persona_count. A commit that bumps
# one half without the others (the recurring "index advanced, repo library
# lagged" divergence) is blocked HERE, early — long before CI or a roll. Fix by
# running the ONE atomic command: pipeline/publish-personas-to-fleet.sh
PERSONA_GUARD="22-book-to-persona-coaching-leadership-system/pipeline/assert-personas-published.sh"
if [ -f "$PERSONA_GUARD" ]; then
  if git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
      | grep -Eq '^(22-book-to-persona-coaching-leadership-system/personas/|22-book-to-persona-coaching-leadership-system/persona-categories\.json|shared-utils/prebuilt-index/INDEX-MANIFEST\.json)'; then
    if ! bash "$PERSONA_GUARD" --repo-only; then
      echo ""
      echo "PRE-COMMIT BLOCKED: persona-set count triad disagrees (blueprint dirs !="
      echo "persona-categories.json keys != INDEX-MANIFEST persona_count/canonical)."
      echo "A persona was added to one half without the others. Bring all four into"
      echo "lockstep in ONE run before committing:"
      echo "  22-book-to-persona-coaching-leadership-system/pipeline/publish-personas-to-fleet.sh"
      exit 1
    fi
  fi
fi

# ── 9. universal-sops content-manifest freshness (sha256 lockstep) ───────────
# universal-sops/_content-manifest.json (scripts/hash-universal-sops-manifest.py)
# is a separate, additive integrity stamp gating the CI job "universal-sops
# content manifest" (.github/workflows/embedding-integrity-guard.yml). Restamping
# it is a fully manual step with nothing local enforcing it, and this exact
# drift has broken main twice in two days on the same file (ec1c4ab2 2026-07-28,
# 69a1ca97 2026-07-30) -- caught only after push, by CI, with no auto-fix. Only
# fires when a staged path is under universal-sops/; does NOT touch (and never
# should) universal-sops/presentation-slide-craft/MANIFEST-SOURCE.txt or
# PIPELINE-MANIFEST.json, which are a separate, independent runtime stamp (see
# the hasher script's own docstring).
if [ -f "scripts/hash-universal-sops-manifest.py" ]; then
  if git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -q '^universal-sops/'; then
    if ! python3 scripts/hash-universal-sops-manifest.py --check; then
      echo ""
      echo "PRE-COMMIT BLOCKED: universal-sops/_content-manifest.json is stale (drift listed above)."
      echo "Re-stamp with the repo's own tool, then stage the result:"
      echo "  scripts/hash-universal-sops-manifest.py && git add universal-sops/_content-manifest.json"
      exit 1
    fi
  fi
fi

# ── 10. Presentations SOP lockstep (SOP-SLIDE-06 gate 2 — FIX 36) ─────────────
# SOP-SLIDE-06-EXTENSION-AND-SYNC.md §3 gate 2: "any commit touching a Presentations
# role .md, a sops/*.md, the manifest, or build_deck.py runs sync_check.py and is
# blocked on drift." The CI half of this gate is live in
# .github/workflows/presentations-drift-gates.yml (GATE 3/GATE 5 targets); this is the
# LOCAL pre-commit half, so drift is caught before the push, not after. Exit codes
# (sync_check.py contract): 0 = in sync; 4 = drift (block); 2 = cannot run (block —
# a broken checker must never wave a commit through).
SYNC_TRIGGER='^(23-ai-workforce-blueprint/templates/role-library/presentations/.*\.md$|23-ai-workforce-blueprint/templates/role-library/presentations/scripts/sops/|23-ai-workforce-blueprint/templates/role-library/presentations/scripts/build_deck\.py$|universal-sops/presentation-slide-craft/)'
if git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep -Eq "$SYNC_TRIGGER"; then
  SYNC_SCRIPT="23-ai-workforce-blueprint/templates/role-library/presentations/scripts/sync_check.py"
  if [ -f "$SYNC_SCRIPT" ]; then
    SYNC_RC=0
    python3 "$SYNC_SCRIPT" --json > /tmp/precommit-sync-check.json 2>/tmp/precommit-sync-check.err || SYNC_RC=$?
    if [ "$SYNC_RC" -ne 0 ]; then
      if [ "$SYNC_RC" -eq 4 ]; then
        echo ""
        echo "PRE-COMMIT BLOCKED: Presentations SOP/code lockstep DRIFT (sync_check.py exit 4):"
        python3 -c "import json;d=json.load(open('/tmp/precommit-sync-check.json'));[print(f\"  - {x.get('check')} | {x.get('item')} | {x.get('detail')}\") for x in d.get('drift',[])]" 2>/dev/null || cat /tmp/precommit-sync-check.err
        echo "Fix by running the documented EXTENSION-SOP sync steps, then re-stage."
      else
        echo ""
        echo "PRE-COMMIT BLOCKED: sync_check.py could not run (exit $SYNC_RC) — fail-closed."
        cat /tmp/precommit-sync-check.err 2>/dev/null
      fi
      rm -f /tmp/precommit-sync-check.json /tmp/precommit-sync-check.err
      exit 1
    fi
    rm -f /tmp/precommit-sync-check.json /tmp/precommit-sync-check.err
    echo "Presentations lockstep check passed (sync_check.py: 0 drift)."
  fi
fi

# ── 5. Version consistency ───────────────────────────────────────────────────
VERSION=$(cat version 2>/dev/null)
INSTALL_VERSION=$(grep 'ONBOARDING_VERSION=' install.sh 2>/dev/null | head -1 | cut -d'"' -f2)
CHANGELOG_VERSION=$(grep -m1 '^\## \[v' CHANGELOG.md 2>/dev/null | sed 's/.*\[//;s/\].*//')

if [ -z "$VERSION" ]; then
  echo "ERROR: version file missing"
  exit 1
fi

if [ "$VERSION" != "$INSTALL_VERSION" ]; then
  echo "ERROR: version ($VERSION) != install.sh ONBOARDING_VERSION ($INSTALL_VERSION)"
  echo "Update install.sh before committing."
  exit 1
fi

if [ "$VERSION" != "$CHANGELOG_VERSION" ]; then
  echo "WARNING: version ($VERSION) != CHANGELOG.md top entry ($CHANGELOG_VERSION)"
  echo "Consider updating CHANGELOG.md before committing."
fi

echo "Version check passed: $VERSION"
echo "Pre-commit QC: all gates passed."
