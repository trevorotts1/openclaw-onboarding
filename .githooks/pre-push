#!/bin/bash
# Pre-push hook. TWO INDEPENDENT STAGES, each with its own blocking rule:
#
#   STAGE 1 — client-name guard  (unchanged; its rule is stated in full below)
#   STAGE 2 — GHL MCP supply-chain pin gate
#
# The stages do not share a blocking rule and must not be read as if they did.
# Stage 1's rule was written deliberately narrow and is reproduced verbatim; it
# governs stage 1 and nothing else. Stage 2 states its own, equally narrow rule
# at the point where it runs.
#
# ── STAGE 1 ──────────────────────────────────────────────────────────────────
# Refuse a push that would carry a real client name into a
# public repo. This repo is a PUBLIC fleet-wide template — a client name,
# business name, or owner-identifying token pushed to origin is a privacy
# violation that CI cannot catch (a bare GitHub runner has no roster by
# design), so the push itself is where it must be stopped.
#
# Gate: scripts/qc-assert-no-client-names.sh — REUSED, never reimplemented.
# The tiering is EXACTLY the gate's own, so this hook and the pre-commit hook
# and CI can never disagree on what "hits" means:
#   1. Curated roster ($OPENCLAW_CLIENT_ROSTER or ~/.openclaw/client-roster.txt)
#   2. Roster DERIVED structurally from ~/clawd/accounts/accounts.md
#   3. Neither available -> structural mode (operator-path + .example
#      placeholder-leak tokens only). Fail-closed here (exit 2) because a real
#      roster source exists on operator boxes; only CI treats that state as
#      report-only. This hook runs on the operator's own box, never on a bare
#      CI runner, so exit 2 is the correct, hard block.
#
# Blocking rule (STAGE 1) — ONLY ever block on the gate's own verdict:
#   * gate exit 1 (roster/always-on-token hit)  -> REFUSE the push.
#   * gate exit 2 (structural, fail-closed)     -> REFUSE the push.
#   * gate exit 0 (clean)                        -> allow; never block a clean tree.
# No other condition can refuse a push in this stage. A transient environment
# problem must not hold up another session's legitimate push of clean content.
#
# Failure output shows paths and counts only, never matched name content:
# strip everything after `path:line` with the same filter CI uses.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT" || exit 1

GATE="scripts/qc-assert-no-client-names.sh"
if [ ! -f "$GATE" ]; then
  echo "PRE-PUSH: $GATE missing — cannot verify this push (fail-closed)."
  exit 1
fi

# QC_GATE_CONTEXT="pre-push" (literal): a push covers a range of commits, not
# one SHA, so the gate's own durable audit log records this run tagged
# "pre-push" rather than any single commit.
OUT="$(QC_GATE_CONTEXT="pre-push" bash "$GATE" 2>&1)"
GATE_RC=$?

case "$GATE_RC" in
  0)
    # Clean — stage 1 raises no objection. Fall through to stage 2.
    echo "PRE-PUSH: client-name gate PASSED (exit 0)."
    ;;
  1)
    echo ""
    echo "PRE-PUSH BLOCKED: real client names detected in tracked files."
    echo "A client name can never be pushed to this public repo."
    echo "Replace each with a generic placeholder (see the gate's output)."
    echo "Hit locations (path:line only — matched content withheld):"
    echo "$OUT" | sed -E 's/^([^:]+:[0-9]+):.*/\1/' | grep -E ':[0-9]+' || true
    exit 1
    ;;
  2)
    echo ""
    echo "PRE-PUSH BLOCKED: client-name gate could not verify (exit 2,"
    echo "fail-closed). Neither a curated roster nor an accounts.md-derived"
    echo "roster is available in this environment, so the per-name scan did"
    echo "not run. Fix by providing a curated roster or an accounts.md source"
    echo "(see \$OPENCLAW_ACCOUNTS_MD), then retry the push."
    echo ""
    echo "Gate output (for diagnosis):"
    echo "$OUT" | sed -E 's/^([^:]+:[0-9]+):.*/\1/'
    exit 1
    ;;
  *)
    # Unexpected gate failure (missing python3, etc.) — refuse loudly rather
    # than let an unverifiable push through. Never print matched content.
    echo ""
    echo "PRE-PUSH BLOCKED: client-name gate exited unexpectedly ($GATE_RC)."
    echo "A push that cannot be verified must not proceed. See gate output:"
    echo "$OUT" | sed -E 's/^([^:]+:[0-9]+):.*/\1/'
    exit 1
    ;;
esac

# ── STAGE 2 — GHL MCP supply-chain pin gate ─────────────────────────────────
# The GHL Community MCP is third-party code built and run on client machines.
# Its vetting record binds a security VERDICT to the commit it judges, the
# dependency lockfile hash and the mirror it is fetched from, via a digest. Edit
# any bound value by hand and the digest stops recomputing.
#
# Why here as well as in CI: CI runs AFTER the push, so a red workflow is a red
# X on a commit that is already on main. This stage catches the realistic
# mistake — an agent or a hurried human pasting a new SHA — at the last moment
# it is still cheap to fix.
#
# THIS IS NOT A SECURITY CONTROL. `git push --no-verify` walks straight past it,
# and it is meant to. It is the fast local layer of a three-layer gate: this
# hook, the CI job, and the box-side installer's own refusal. The layer that
# actually protects the client machine is the last one.
#
# Blocking rule (STAGE 2) — deliberately narrower than stage 1's:
#   * gate exit 1 (a definite, reproducible pin failure) -> REFUSE the push.
#   * gate exit 2 (the gate could not run at all)        -> WARN, allow.
#   * gate exit 0                                        -> allow.
# Exit 2 does not block because it means "this environment could not check",
# not "this tree is wrong" — and the CI job, which always can check, is the
# backstop for exactly that case. Stage 1 fails closed on its exit 2 because a
# roster source genuinely exists on an operator box; this gate has no such
# environmental prerequisite, so the same reasoning does not carry over.
#
# Offline by design: no --network. A push must not depend on GitHub being
# reachable from wherever it is run. Mirror reachability and the lockfile
# comparison are CI's job.
PIN_GATE="scripts/qc-assert-ghl-mcp-pin-gate.sh"
if [ -f "$PIN_GATE" ]; then
  PIN_OUT="$(bash "$PIN_GATE" 2>&1)"
  PIN_RC=$?
  case "$PIN_RC" in
    0)
      echo "PRE-PUSH: GHL MCP pin gate PASSED (exit 0) — push allowed."
      ;;
    2)
      echo ""
      echo "PRE-PUSH WARNING: the GHL MCP pin gate could not run (exit 2)."
      echo "Nothing was verified locally. CI will check it — watch the"
      echo "ghl-mcp-pin-gate job on this push."
      echo "$PIN_OUT"
      ;;
    *)
      echo ""
      echo "PRE-PUSH BLOCKED: the GHL MCP supply-chain pin gate FAILED."
      echo ""
      echo "$PIN_OUT"
      echo ""
      echo "The vetting record no longer matches what it claims to have vetted."
      echo "Do not hand-repair it. Re-run the review and seal the result:"
      echo "    bash scripts/ghl-mcp-vet-pin.sh <commit-sha>                  # review"
      echo "    bash scripts/ghl-mcp-vet-pin.sh <commit-sha> --verdict clean  # seal"
      exit 1
      ;;
  esac
fi

# ── STAGE 3 — added-lines absolute-path guard (D-27) ────────────────────────
# A push may not ADD a host-specific absolute path. The two banned roots are the
# macOS external-volume root and the macOS user-home root; tools/gate-added-paths.sh
# assembles both from parts, so that script never contains the text it scans for.
# Do not write either root as a literal here either — this hook is scanned too.
#
# Judged over origin/main...HEAD: the range this push actually adds. If the
# guard script is absent (a branch that predates it) the stage is skipped rather
# than failed — a hook that blocks every push over a file that has not landed
# yet is a hook people learn to bypass with --no-verify.
#
# Blocking rule (STAGE 3) — the guard's own verdict, fail-closed:
#   * exit 1 (a banned path is added)  -> REFUSE the push.
#   * exit 2 (the guard could not run) -> REFUSE the push.
#   * exit 0 (clean)                   -> allow.
# Exit 2 BLOCKS here, unlike stage 2. The reasoning differs because the
# prerequisite differs: stage 2 needs a third-party vetting record a given box
# may genuinely lack, while this guard is only local git plus bash. An exit 2
# here is a real instrumentation fault, never "this box cannot check" — and a
# gate that cannot run must not be allowed to report clean.
PATH_GUARD="tools/gate-added-paths.sh"
if [ -f "$PATH_GUARD" ] && git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
  PATH_OUT="$(bash "$PATH_GUARD" . origin/main HEAD 2>&1)"
  PATH_RC=$?
  echo "$PATH_OUT"
  case "$PATH_RC" in
    0)
      echo "PRE-PUSH: added-paths guard PASSED (exit 0) — push allowed."
      ;;
    2)
      echo ""
      echo "PRE-PUSH BLOCKED: the added-paths guard could not run (exit 2,"
      echo "INSTRUMENT_ERROR). Failing closed: a push the gate could not verify"
      echo "must not proceed. Diagnostic output is above."
      exit 1
      ;;
    *)
      echo ""
      echo "PRE-PUSH BLOCKED: this push ADDS a banned host-specific absolute path"
      echo "(the macOS external-volume root or the macOS user-home root) in the"
      echo "range origin/main...HEAD. The offending lines are listed above."
      echo "Rewrite each as a repo-relative path — or, where the string must exist"
      echo "on purpose (a scanner naming its own target), assemble it from"
      echo "concatenated parts so the literal is never committed."
      exit 1
      ;;
  esac
fi

exit 0
