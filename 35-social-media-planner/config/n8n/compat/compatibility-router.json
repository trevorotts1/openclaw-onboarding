        "jsCode": "const r=$input.first().json;if(!Number.isInteger(r.statusCode)||r.statusCode<200||r.statusCode>599||!r.body||typeof r.body!=='object'||Array.isArray(r.body))throw new Error('Downstream response could not be verified');return [{json:{statusCode:r.statusCode,body:r.body}}];"
