    {
      "name": "Create Compatibility Hook",
      "id": "create-compatibility-hook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "social-planner-sheet-create",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "name": "Create Contract",
      "id": "create-contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        150,
        0
      ],
      "parameters": {
        "jsCode": "const b=$input.first().json.body;\nif(!b||typeof b!=='object'||Array.isArray(b))throw new Error('Expected a single request object');\nconst allowed=[\"brandName\", \"clientEmail\"];\nconst legacy=Object.keys(b).every(k=>allowed.includes(k))&&allowed.every(k=>Object.prototype.hasOwnProperty.call(b,k));\nreturn [{json:{body:b,legacy}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Create Legacy Shape",
      "id": "create-legacy-shape",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "legacy",
              "leftValue": "={{ $json.legacy }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
