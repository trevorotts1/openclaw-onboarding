      "id": "validate-legacy-share-result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3060,
        0
      ],
      "parameters": {
        "jsCode": "const c=$('Resolve Legacy Sheet').first().json,r=$input.first().json;\nif(!$('Check Legacy Sharing').first().json.shared && !(r.id&&r.type==='anyone'&&r.role==='writer'&&!r.deleted&&!r.expirationTime))throw new Error('Sharing was not confirmed');\nreturn [{json:{status:'success',sheetId:c.id,sheetUrl:'https://docs.google.com/spreadsheets/d/'+c.id+'/edit',sheetName:c.name,sharedWith:'anyone with the link can edit',clientEmail:c.email,deduped:$('Resolve Legacy Copy').first().json.existing,mode:'legacy_document_only',company_registration_verified:false,publication_verified:false}}];"
      },
      "onError": "continueErrorOutput"
    },
