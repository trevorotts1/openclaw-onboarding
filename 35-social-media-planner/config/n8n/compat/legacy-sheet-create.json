      ],
      "parameters": {
        "jsCode": "const r=$input.first().json,c=$('Validate Legacy Share Result').first().json;if(r.id!==c.sheetId||r.appProperties?.skill35_legacy_state!=='ready')throw new Error('Legacy readiness tag not confirmed');return [{json:c}];"
      },
      "onError": "continueErrorOutput"
    },
