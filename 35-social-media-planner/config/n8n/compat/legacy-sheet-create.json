      "parameters": {
        "method": "PUT",
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/' + $('Resolve Legacy Sheet').first().json.id + '/values/Weekly%20Overview!A1:T2?valueInputOption=RAW' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"values\": [[\"SOCIAL MEDIA PLANNER - WEEKLY OVERVIEW\"], [\"Week Of\", \"Theme of the Week\", \"Research\", \"Core Content\", \"Images\", \"Videos\", \"Facebook\", \"Instagram\", \"LinkedIn\", \"YouTube\", \"TikTok\", \"Pinterest\", \"Carousels\", \"Blog\", \"Podcast\", \"Email\", \"QC\", \"Scheduled\", \"Overall\", \"Notes\"]]}"
      },
      "onError": "continueErrorOutput"
