{
  "name": "Social planner legacy document creator compatibility",
  "nodes": [
    {
      "name": "Legacy Create Hook",
      "id": "legacy-create-hook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "path": "social-planner-compat-20260909/legacy-sheet-create",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "name": "Validate Legacy Create",
      "id": "validate-legacy-create",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        180,
        0
      ],
      "parameters": {
        "jsCode": "const b=$input.first().json.body;\nif(!b || typeof b!=='object' || Array.isArray(b))throw new Error('Expected one legacy object');\nif(Object.keys(b).some(k=>!['brandName','clientEmail'].includes(k)))throw new Error('Use current company-bound route for non-legacy fields');\nconst modern=['company_id','companyId','schema_version','schemaVersion','planner_kind','provisioning_key','templateSheetId','cycle_id','content_revision','account_id'];\nif(modern.some(k=>Object.prototype.hasOwnProperty.call(b,k)))throw new Error('Modern request must use strict company-bound create route');\nfor(const k of ['brandName','clientEmail'])if(typeof b[k]!=='string'||!b[k].trim()||/[\\x00-\\x1f]/.test(b[k]))throw new Error('Legacy create requires '+k);\nconst brand=b.brandName.trim(),email=b.clientEmail.trim();\nconst bytes=s=>encodeURIComponent(s).replace(/%[A-F0-9]{2}/g,'x').length;\nif(bytes('skill35_legacy_brand')+bytes(brand)>124||bytes('skill35_legacy_email')+bytes(email)>124)throw new Error('Use current company-bound setup for long identity fields');\nif(!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email))throw new Error('Invalid clientEmail');\nconst esc=s=>s.replace(/\\\\/g,'\\\\\\\\').replace(/'/g,\"\\\\'\");\nreturn [{json:{brand,email,name:brand+' Social Media Planner',query:\"trashed = false and appProperties has { key='skill35_legacy_brand' and value='\"+esc(brand)+\"' } and appProperties has { key='skill35_legacy_email' and value='\"+esc(email)+\"' }\"}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Read Legacy Copies",
      "id": "read-legacy-copies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://www.googleapis.com/drive/v3/files?q=' + encodeURIComponent($json.query) + '&fields=files(id,name,mimeType,trashed,appProperties),nextPageToken&pageSize=100' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Resolve Legacy Copy",
      "id": "resolve-legacy-copy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json,c=$('Validate Legacy Create').first().json;\nif(!Array.isArray(r.files)||r.nextPageToken||r.files.length>1)throw new Error('Ambiguous legacy document; reconcile existing copies');\nconst f=r.files[0];if(f&&(f.mimeType!=='application/vnd.google-apps.spreadsheet'||f.trashed||f.appProperties?.skill35_legacy_brand!==c.brand||f.appProperties?.skill35_legacy_email!==c.email))throw new Error('Legacy document identity mismatch');\nif(f&&!['initializing','formatted','ready'].includes(f.appProperties?.skill35_legacy_state))throw new Error('Existing legacy document needs preserving migration; refusing initialization');\nreturn [{json:{...c,existing:!!f,id:f?.id||null,state:f?.appProperties?.skill35_legacy_state||'initializing'}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Legacy Copy Exists",
      "id": "legacy-copy-exists",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "exists",
              "leftValue": "={{ $json.existing }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Copy Legacy Template",
      "id": "copy-legacy-template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files/__LEGACY_TEMPLATE_ID__/copy?fields=id,name,mimeType",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $('Validate Legacy Create').first().json.name, parents: ['root'], appProperties: { skill35_legacy_brand: $('Validate Legacy Create').first().json.brand, skill35_legacy_email: $('Validate Legacy Create').first().json.email, skill35_legacy_document: 'true', skill35_legacy_state: 'initializing' } }) }}"
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Resolve Legacy Sheet",
      "id": "resolve-legacy-sheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json,c=$('Validate Legacy Create').first().json;\nif(typeof r.id!=='string'||!/^[A-Za-z0-9_-]{10,160}$/.test(r.id))throw new Error('No valid copied sheet ID');\nif(r.existing!==true&&r.mimeType!=='application/vnd.google-apps.spreadsheet')throw new Error('Copy is not a spreadsheet');\nreturn [{json:{...c,id:r.id,state:r.state||'initializing'}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Read Legacy Permissions",
      "id": "read-legacy-permissions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1260,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://www.googleapis.com/drive/v3/files/' + $json.id + '/permissions?fields=permissions(id,type,role,deleted,expirationTime),nextPageToken&pageSize=100' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Check Legacy Sharing",
      "id": "check-legacy-sharing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;if(!Array.isArray(r.permissions)||r.nextPageToken)throw new Error('Cannot verify sharing');\nconst shared=r.permissions.some(p=>p.type==='anyone'&&p.role==='writer'&&!p.deleted&&!p.expirationTime);\nconst c=$('Resolve Legacy Sheet').first().json;if(c.state==='initializing'&&r.permissions.some(p=>!p.deleted&&p.role!=='owner'))throw new Error('Refusing to clear a shared legacy document');\nreturn [{json:{...c,shared}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Legacy Needs Initialization",
      "id": "legacy-needs-initialization",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1620,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "init",
              "leftValue": "={{ $json.state === 'initializing' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Read New Copy Tabs",
      "id": "read-new-copy-tabs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1800,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://sheets.googleapis.com/v4/spreadsheets/' + $('Resolve Legacy Sheet').first().json.id + '?fields=spreadsheetId,sheets(properties)' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Build New Copy Clear",
      "id": "build-new-copy-clear",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json,c=$('Resolve Legacy Sheet').first().json;\nif(r.spreadsheetId!==c.id||!Array.isArray(r.sheets)||!r.sheets.some(s=>s.properties?.title==='Weekly Overview'))throw new Error('Unexpected copied template layout');\nreturn [{json:{ranges:r.sheets.map(s=>\"'\"+s.properties.title.replace(/'/g,\"''\")+\"'!A:ZZZ\")}}];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "name": "Clear New Copy Sample Values",
      "id": "clear-new-copy-sample-values",
      "type": "n8n-nodes-base.httpRequest",
