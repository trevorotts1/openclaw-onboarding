{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-owner contract for interactive workflow steps",
  "description": "PBB-115 T-19 / C-19. One declarative record binds every interactive workflow input (rendered controls, provider callbacks, free text and stale taps) to exactly one responder. The owner is OpenClaw's inbound path by default. A native GHL owner is only admitted when a launch bundle at the same tenant names it, because the launch conversation gate -- not this record -- owns the native_ghl approval decision.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "inbound_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "openclaw_inbound",
            "native_ghl"
          ]
        },
        "inbound_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "launch_bundle": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "responders": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "openclaw_inbound",
              "native_ghl"
            ]
          }
        },
        "required": [
          "id",
          "kind"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "controls": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "free_text": {
            "enum": [
              "accept",
              "reject"
            ]
          }
        },
        "required": [
          "step_id",
          "generation",
          "controls",
          "free_text"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "steps"
  ]
}
