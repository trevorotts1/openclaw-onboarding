        "bonus_asset_versions",
        "conversation_policy_version",
        "allowed_spare_ids",
        "precondition"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "enum": [
                  "REVEAL_COMMENT",
                  "BONUS_COMMENT"
                ]
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "parent_post_id": {
                "type": "string",
                "minLength": 1
              },
              "precondition": {
                "properties": {
                  "parent_post_verified": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "SCHEDULED_POST"
              }
            },
            "required": [
              "purpose"
            ]
          },
          "then": {
            "properties": {
              "parent_post_id": {
                "const": null
              }
            }
          }
        }
      ]
    },
