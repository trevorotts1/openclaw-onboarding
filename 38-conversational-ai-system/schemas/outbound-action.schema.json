          "minLength": 1
        },
        "keyword": {
          "type": "string",
          "minLength": 1
        },
        "promised_item_version": {
          "type": "string",
          "minLength": 1
        },
        "bonus_asset_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conversation_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "allowed_spare_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "precondition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "placement_approved",
            "tenant_publication_active",
            "parent_post_verified"
          ],
          "properties": {
            "placement_approved": {
              "const": true
            },
            "tenant_publication_active": {
              "type": "boolean"
            },
            "parent_post_verified": {
              "type": "boolean"
            }
          }
        },
        "messenger_page_id": {
          "type": "string",
          "pattern": "^[0-9]{5,20}$"
        },
        "messenger_ref": {
          "type": "string",
          "pattern": "^pb-(JAN|FEB|MAR|APR|MAY|JUN|JUL|AUG|SEP|OCT|NOV|DEC)(0[1-9]|[12][0-9]|3[01])-20[0-9]{2}-[A-Z0-9]{1,32}$"
        },
        "messenger_link": {
          "type": "string",
          "pattern": "^https://m\\.me/[0-9]{5,20}\\?ref=pb-(JAN|FEB|MAR|APR|MAY|JUN|JUL|AUG|SEP|OCT|NOV|DEC)(0[1-9]|[12][0-9]|3[01])-20[0-9]{2}-[A-Z0-9]{1,32}$"
        }
      },
      "required": [
        "schema_version",
        "action_id",
        "logical_intent_key",
        "tenant_id",
        "channel",
        "account_id",
