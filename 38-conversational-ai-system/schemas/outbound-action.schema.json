{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strict outbound envelope: public placement or person-directed",
  "description": "Purple Billboard DATA-CONTRACTS section 2. A strict oneOf: a public placement never carries a canonical contact, and a person-directed action always does. Each branch carries its own dispatch-gate shape (DATA-CONTRACTS section 3) because the checks are different; a gate record is evidence of one check, never a standing permission.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1
        },
        "logical_intent_key": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "FB_PUBLIC",
            "IG_PUBLIC"
          ]
        },
        "account_id": {
          "type": "string",
          "minLength": 1
        },
        "account_binding_revision": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "playbook_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledge_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownership_fence": {
          "type": "integer",
          "minimum": 0
        },
        "expected_state_version": {
          "type": "integer",
          "minimum": 0
        },
        "content_revision": {
          "type": "string",
          "minLength": 1
        },
        "asset_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "not_before": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "queued",
            "dispatching",
            "accepted",
            "sent",
            "delivered",
            "failed_not_sent",
            "failed_after_acceptance",
            "unknown",
            "suppressed",
            "quarantined",
            "expired"
          ]
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt_id",
              "provider_object_id",
              "status",
              "evidence_id"
            ],
            "properties": {
              "attempt_id": {
                "type": "string",
                "minLength": 1
              },
              "provider_object_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "evidence_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "receipt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider_post_id",
            "provider_comment_id",
            "supported_status",
            "recorded_at",
            "evidence_id"
          ],
          "properties": {
            "provider_post_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "provider_comment_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "supported_status": {
              "type": [
                "string",
                "null"
              ]
            },
            "recorded_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "dispatch_gate": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "checked_at",
            "decision",
            "publication_paused",
            "parent_post_verified",
            "approval_revision",
            "suppression_revision",
            "owner_fence",
            "binding_revision",
            "policy_revision",
            "authority_revision",
            "lifecycle_state",
            "content_revision",
            "asset_version_id",
            "schedule_evidence_id",
            "quiet_rule_status",
            "platform_publishing_permission",
            "reveal_order_verified"
          ],
          "properties": {
            "checked_at": {
              "type": "string",
              "minLength": 1
            },
            "decision": {
              "enum": [
                "ALLOW",
                "WAIT_UNTIL",
                "SUPPRESSED",
                "QUARANTINED",
                "RECONCILE_UNKNOWN"
              ]
            },
            "publication_paused": {
              "type": "boolean"
            },
            "parent_post_verified": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "approval_revision": {
              "type": "string",
              "minLength": 1
            },
            "suppression_revision": {
              "type": "string",
              "minLength": 1
            },
            "owner_fence": {
              "type": "integer",
              "minimum": 0
            },
            "binding_revision": {
              "type": "string",
              "minLength": 1
            },
            "policy_revision": {
              "type": "string",
              "minLength": 1
            },
            "authority_revision": {
              "type": "string",
              "minLength": 1
            },
            "lifecycle_state": {
              "enum": [
                "NOT_INSTALLED",
                "ADOPTING",
                "RUNNING",
                "PAUSED_RESUMABLE",
                "CLOSING",
                "CLOSED",
                "CANCELED"
              ]
            },
            "content_revision": {
              "type": "string",
              "minLength": 1
            },
            "asset_version_id": {
              "type": "string",
              "minLength": 1
            },
            "schedule_evidence_id": {
              "type": "string",
              "minLength": 1
            },
