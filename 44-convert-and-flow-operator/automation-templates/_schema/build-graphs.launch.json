  "automation-templates/launch-ai/customer-replied-conversation-ai.json": {
    "kind": "sequence_stack",
    "build_graph": [
      {"id":"trg","type":"trigger","attributes":{"event":"Customer Replied","channels":["SMS","Chat"],"ref":"Trigger: Customer Replied (SMS + Chat)"}},
      {"id":"n1","type":"if_else","after":"trg","branches":{"true":"n2","false":"n3"},"attributes":{"condition":"launch-ai-optout tag present","ref":"`launch-ai-optout` present → Stop. No → continue"}},
      {"id":"n2","type":"workflow_goal","after":"n1","attributes":{"goal":"opt-out exits without answering","ref":"Stop, never answer"}},
      {"id":"n3","type":"conversation_ai","after":"n1","attributes":{"agent":"launch agent","playbook":"Skill 38 registered playbook","ref":"Action: Conversation AI"}},
      {"id":"n4","type":"if_else","after":"n3","branches":{"booked":"n5","answered":"n10","timed_out":"n12"},"attributes":{"condition":"Conversation AI outcome","outcomes":["booked","answered","timed_out"],"ref":"Branch: outcome booked / answered / timed out"}},
      {"id":"n5","type":"add_contact_tag","after":"n4","attributes":{"tag":"launch-ai-booked","ref":"Add tag `launch-ai-booked`"}},
      {"id":"n6","type":"remove_from_workflow","after":"n5","attributes":{"target":"launch AI re-invite path","ref":"Remove from the launch AI re-invite path"}},
      {"id":"n7","type":"create_opportunity","after":"n6","attributes":{"stage":"booked","condition":"if launch pipeline exists","ref":"Create/update opportunity at the booked stage"}},
      {"id":"n8","type":"email","after":"n7","attributes":{"message":"approved booking confirmation","ref":"Send the approved confirmation message"}},
      {"id":"n9","type":"internal_notification","after":"n8","attributes":{"recipient":"owner","detail":"contact name and booking time","ref":"Notify the owner"}},
      {"id":"n10","type":"add_contact_tag","after":"n4","attributes":{"tag":"launch-ai-answered","ref":"Add tag `launch-ai-answered`"}},
      {"id":"n11","type":"add_contact_tag","after":"n4","attributes":{"tag":"launch-ai-timed-out","ref":"Add tag `launch-ai-timed-out`"}},
      {"id":"n12","type":"wait","after":"n11","attributes":{"duration":"1 day","kind":"duration","ref":"Wait 1 day (duration)"}},
      {"id":"n13","type":"sms","after":"n12","attributes":{"message":"approved booking and/or checkout link nudge","ref":"SMS nudge with `{{booking_link}}` / `{{checkout_link}}`"}},
      {"id":"n14","type":"wait","after":"n13","attributes":{"duration":"1 day","kind":"duration","ref":"Wait 1 day"}},
      {"id":"n15","type":"add_contact_tag","after":"n14","attributes":{"tag":"launch-ai-dormant","ref":"tag `launch-ai-dormant`"}},
      {"id":"n16","type":"conversation_ai","after":"n15","attributes":{"action":"update_bot_and_status","keyword":"CALL","vocabulary_status":"unverified type string","ref":"Update Conversation AI Bot and Status"}},
      {"id":"n17","type":"add_contact_tag","after":"n16","attributes":{"tag":"launch-ai-replied","ref":"Action: Add Tag `launch-ai-replied`"}},
      {"id":"n18","type":"workflow_goal","after":"n9","attributes":{"goal":"booked branch exits","ref":"Stop"}},
      {"id":"n19","type":"workflow_goal","after":"n10","attributes":{"goal":"answered branch remains listening","ref":"Stop (promo sequence continues outside this workflow)"}},
      {"id":"n20","type":"workflow_goal","after":"n17","attributes":{"goal":"keyword wake-up and re-entry guard complete","ref":"re-activates the bot and sets status active"}}
    ]
  }
