    }
   },
   {
    "id": "n5",
    "type": "email",
    "after": "n3",
    "attributes": {
     "message": "no-show replay",
     "ref": "No-show replay email"
    }
   },
   {
    "id": "n6",
    "type": "if_else",
    "after": "n4",
    "branches": {
     "true": "n7",
     "false": "n9"
    },
    "attributes": {
     "condition": "SMS consent present",
     "ref": "If SMS consent"
    }
   },
   {
    "id": "n8",
    "type": "if_else",
    "after": "n5",
    "branches": {
     "true": "n7",
     "false": "n9"
    },
    "attributes": {
     "condition": "SMS consent present",
     "ref": "If SMS consent"
    }
   },
   {
    "id": "n7",
    "type": "sms",
    "after": [
     "n6",
     "n8"
    ],
    "attributes": {
     "message": "branch-matched SMS",
     "ref": "Branch-matched SMS",
     "join": true
    }
   },
