{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Signature Launch approved-domain record",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "launch_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "journey_mode": {
      "enum": [
        "single_simple",
        "multiple_options",
        "free_entry",
        "folded_levels"
      ]
    },
    "status": {
      "enum": [
        "collecting",
        "awaiting_plan_approval",
        "approved",
        "building",
        "blocked"
      ]
    },
    "brand_ref": {
      "type": "string",
      "minLength": 1
    },
    "brand_hash": {
      "type": "string",
      "minLength": 1
    },
    "prompt_policy_id": {
      "type": "string",
      "minLength": 1,
      "description": "v1.1 (Q12 prompt-policy reconciliation, S49): OPTIONAL name of the governing prompt policy, minted by the common registry only. Top-level field beside brand_ref/brand_hash (the implemented record is flat; the brand group exists only in packet doc 02 section 2), plan-approved content inside the plan document hash (which excludes only status and plan_approval_ref). dispatch_launch stamps it into every emitted page request (page-request schema 1.1) when present. Never null and never an empty string: absence is the only encoding of 'no policy'. Records without the field remain 1.0 documents under the preserved launch.v1.0.schema.json."
    },
    "route_graph_ref": {
      "type": "string",
      "minLength": 1
    },
    "route_graph_hash": {
      "type": "string",
      "minLength": 1
    },
    "plan_approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "offers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "title": "Signature Launch offer",
        "properties": {
          "offer_id": {
            "type": "string",
            "minLength": 1
          },
          "slot": {
            "enum": [
              "main",
              "bump",
              "upsell_1",
              "downsell_1",
              "upsell_2"
            ]
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entitlement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "excludes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "relationships": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional. included_in names the main offers whose buyers hold this (bump) offer's entitlements by design; their order forms do not sell it, and the bump-subset-of-main rule skips them.",
            "properties": {
              "included_in": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "native_product_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "production_state": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "authored",
              "draft_delivered",
              "locally_verified",
              "installed_test_verified",
              "ready_for_activation",
              "live_verified",
              "failed",
              null
            ],
            "description": "Shared-semantics boundary: OFFER IDENTITY (BFL-001). How far this offer's own sellable artifacts (native product, native price, delivery artifact) have actually got. The values are the unit receipt's existing ladder in 83-black-friday-launcher/receipt.schema.json (definitions.unit_receipt.status) plus 'failed', so the package cannot hold two competing vocabularies; 'authored' means the offer is written down only. null or absence means nothing is recorded, and no lane may infer production from the offer being present, from a native id being planned, or from an artifact existing on disk. Only the receipt row that actually proves the state may set it."
          },
          "prices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "additionalProperties": false,
              "title": "Approved price choice",
              "properties": {
                "price_choice_id": {
                  "type": "string",
                  "minLength": 1
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "amount_minor": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "billing_type": {
                  "enum": [
                    "one_time",
                    "recurring",
                    "installment",
                    "trial"
                  ]
                },
                "native_price_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "schedule": {
                  "type": "array",
                  "items": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "type": "object",
                    "additionalProperties": false,
                    "title": "Schedule row",
                    "properties": {
                      "amount_minor": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "due": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "amount_minor",
                      "due"
                    ]
                  }
                },
                "terms_source": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "approval_status": {
                  "enum": [
                    "provided",
                    "recommended_unapproved",
                    "approved",
                    "unknown"
                  ]
                }
              },
              "required": [
                "price_choice_id",
                "currency",
                "amount_minor",
                "billing_type",
                "native_price_id",
                "schedule",
                "approval_status"
              ]
            }
          },
          "source_kind": {
            "enum": [
              "owner",
              "existing_verified_catalog",
              "recommendation",
              "test_fixture"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "test_only": {
            "type": "boolean"
          },
          "intended_buyer": {
            "type": [
              "string",
              "null"
            ]
          },
          "primary_outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "limited_deliverables": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          },
          "conditional_deliverables": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ]
            }
          }
        },
        "required": [
          "offer_id",
          "slot",
          "display_name",
          "deliverables",
          "exclusions",
          "entitlement_ids",
          "requires",
          "excludes",
          "native_product_id",
          "prices",
          "source_kind",
          "source_ref",
          "test_only"
        ]
      }
    },
    "delivery_bindings": {
      "type": "object",
      "description": "OPTIONAL per-entitlement delivery binding (S82-DEC-DELIVERYURL-01, S49): keyed by entitlement_id, one binding per entitlement, read by Skill 44's fulfillment-map producer (CR-S82-003) for granted entitlements. Absence of the key, and absence of an entitlement's entry within it, are the only encodings of 'unbound'; an unbound entitlement keeps the producer's pre-binding behavior exactly. An empty object is refused by the validator (absence is the one encoding of 'no bindings'). A binding's delivery_url may be null: the kind is bound, no destination is recorded yet. Values are per-launch commercial facts recorded at plan approval; the field is plan-approved content inside the plan document hash, which excludes only status and plan_approval_ref.",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "title": "Delivery binding",
        "properties": {
          "delivery_kind": {
            "enum": [
              "access",
              "download",
              "schedule_included_service"
            ]
          },
          "delivery_url": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "^https://\\S+$"
          }
        },
        "required": [
          "delivery_kind",
          "delivery_url"
        ]
      }
    },
    "extras": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "title": "Extra-offer flags",
      "properties": {
        "upsell_1": {
          "type": "boolean"
        },
        "downsell_1": {
          "type": "boolean"
        },
        "upsell_2": {
          "type": "boolean"
        }
      },
      "required": [
        "upsell_1",
        "downsell_1",
        "upsell_2"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "upsell_1": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "downsell_1": {
                "const": false
              },
              "upsell_2": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "bump_enabled": {
      "type": "boolean"
    },
    "image_provider": {
      "enum": [
        "kie",
        "agnes",
        "other_explicit"
      ]
    },
    "free_entry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Shared-semantics boundary: FREE ENTRY (BFL-001). The distinct free product/asset a launch gives away, the opt-in path that acquires it, and the real delivery reference for it. Present only when journey_mode is 'free_entry'; absent means the launch records no free item. The free item is handed over by delivery_ref and is never routed through paid checkout: it names an offers[] entry whose price amount_minor is 0 with an approval_status that is not 'unknown', which is the only zero-price route 49-signature-funnel/scripts/launch_plan.py already accepts (outside free_entry a zero amount is a missing fact, never a price). Because the field is additive, absence is not refused by this schema; the record producer must supply it whenever journey_mode is 'free_entry'.",
      "required": [
        "offer_id",
        "opt_in_path",
        "delivery_ref"
      ],
      "properties": {
        "offer_id": {
          "type": "string",
          "minLength": 1,
          "description": "The offers[] entry that is the free product/asset. It reuses that entry's stable offer id; no second id is minted here."
        },
        "opt_in_path": {
          "type": "string",
          "minLength": 1,
          "description": "The opt-in the client actually runs to acquire the free item (form or landing path). Never synthesized."
        },
        "delivery_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "pattern": "\\S",
          "description": "The real delivery reference the free item is handed over with (hosted asset URL, access link, or fulfillment reference). null until a real one exists; a null here is a recorded gap, not a delivery."
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "description": "answers-file:<key>[<index>] entry this free item came from, in the client-intake-answers/v1 convention, so the client's own source text and acceptance references keep resolving from the answers file instead of being copied here."
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "test_only": {
      "type": "boolean"
    },
    "selection_faq": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "answer"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "trust_items": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "location_id",
    "launch_id",
    "revision",
    "journey_mode",
    "status",
    "brand_ref",
    "brand_hash",
    "route_graph_ref",
    "route_graph_hash",
    "plan_approval_ref",
    "offers",
    "extras",
    "bump_enabled",
    "image_provider",
    "source_refs",
    "test_only"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "building"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "plan_approval_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
