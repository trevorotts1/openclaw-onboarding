{
  "registry_version": "1.0.0",
  "contract": "signature-launch-email-profiles",
  "owner": "Skill 50 Email Engine — one profile registry for the planner, the launch intake adapter, authoring, the prover (tools/prove-email.py) and build emission (tools/emit_build_plan.py)",
  "source_of_truth": "50-email-engine/email-library/sequences/*.json (each family's sequence record); this registry is the machine-readable projection those consumers share, so a count, pairing rule, purpose or timing is defined ONCE",
  "consumers": [
    "planner",
    "adapter",
    "authoring",
    "prover",
    "build_emission"
  ],
  "intake_mode": "signature_launch",
  "override_policy": {
    "word_band_override": "locked_brief_only",
    "expected_preview_count": "refused",
    "subject_mode": "locked_brief_only",
    "note": "An override is honored only when it is declared reviewable here AND echoed in the LOCKED brief; anything else is AF-EMAIL-OVERRIDE-UNLOGGED and the profile default re-applies. Preview count is a profile property, never an override surface."
  },
  "families": [
    {
      "kind": "pre_launch",
      "profile": "signature_launch_prelaunch",
      "sequence_position": "signature-launch-prelaunch",
      "sequence_id": "signature-launch-prelaunch",
      "sequence_record": "email-library/sequences/signature-launch-prelaunch.json",
      "purpose": "Teaser -> value -> doors open soon: warm the list and send every CTA to the opt-in / waitlist page.",
      "destination": "opt-in / waitlist page",
      "email_count": 5,
      "preview_count": 2,
      "subject_count": 2,
      "subject_mode": "convert_and_flow",
      "objective": "promotional",
      "framework_map": {
        "1": "star-chain-hook",
        "2": "pastor-story",
        "3": "features-to-benefit",
        "4": "before-after-bridge",
        "5": "pas"
      },
      "cta_rules": {
        "default": 1
      },
      "word_band": {
        "default": [150, 300]
      },
      "disruptive_required": false,
      "strict_review": false,
      "timing": {
        "anchor": "launch_calendar.doors_open_at",
        "rule": "E1 at announcement, E2-E4 spaced across the pre-launch window, E5 on the day before doors open; every stated date or deadline comes from the brief, never invented",
        "wait_after_hours": [72, 48, 24, 24]
      },
      "eligibility": [
        {"rule": "enroll_from_waitlist_or_optin", "source_ref": "approved_signature_landing_page"},
        {"rule": "email_consent_required", "policy_ref": "approved_communication_policy"}
      ],
      "lifecycle": {
        "stop_rules": [
          {"rule": "stop_on_unsubscribe", "scope": "this_campaign_only"},
          {"rule": "stop_on_launch_calendar_superseded", "scope": "this_campaign_only"}
        ],
        "suppression_rules": [
          {"rule": "recheck_eligibility_immediately_before_send", "applies_to": "each_scheduled_email_step", "checks": ["unsubscribe", "launch_calendar_current"]}
        ]
      },
      "sender": {"required_refs": ["sender_profile_ref", "reply_to_ref"], "source": "approved shared-launch brief (sender name + reply-to)", "transactional": false},
      "overrides": {"word_band_override": "locked_brief_only", "expected_preview_count": "refused", "subject_mode": "locked_brief_only"}
    },
    {
