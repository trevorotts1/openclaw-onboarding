#!/usr/bin/env python3
"""presentation-outbox-queue — the FIX 69 file-queue notify transport.

Contract (matches report.dispatch3 / notify_preflight expectations):
  * reads ONE JSON notify row on stdin: {"chat_id":...,"kind":...,"message":...}
  * appends it, one JSON object per line, to the run dir's
    working/outbox.jsonl (the file queue the host relays)
  * exit 0 on queued, non-zero on malformed input / unwritable queue

Run-dir resolution (PRES-050: no cwd guessing):
  * $PRESENTATION_RUN_DIR (bin/presentation callers pass it through the env)
    is REQUIRED. Without it the transport refuses (exit 4) instead of
    appending to whatever directory the caller happens to stand in — a
    guessed write is how one client's rows land in another client's run.
openclaw is NEVER invoked here — this transport exists precisely because the
gateway CLI is absent on the host (FIX 69); the HOST relays the rows.
"""
import json
import os
import sys


def _run_dir() -> str:
    """Return the RUN DIR (the dir that contains working/).

    PRES-050: $PRESENTATION_RUN_DIR is required. The old cwd-guessing
    fallback is removed: writing to $PWD because the env was unset puts
    rows in an unrelated directory with no error, which is silent
    cross-client misdelivery. Callers get exit 4 (refused, no write).
    """
    env = os.environ.get("PRESENTATION_RUN_DIR", "")
    if env and os.path.isdir(env):
        return env
    return ""


def main() -> int:
    try:
        row = json.load(sys.stdin)
    except json.JSONDecodeError as exc:
        print(f"outbox-queue: stdin is not valid JSON: {exc}", file=sys.stderr)
        return 3
    if not isinstance(row, dict):
        print("outbox-queue: stdin JSON must be an object", file=sys.stderr)
        return 3
    rd = _run_dir()
    if not rd:
        print("outbox-queue: PRESENTATION_RUN_DIR is unset or not a directory; "
              "refusing to guess from cwd (no write performed)", file=sys.stderr)
        return 4
    working = rd if os.path.basename(rd) == "working" else os.path.join(rd, "working")
    outbox = os.path.join(working, "outbox.jsonl")
    try:
        os.makedirs(working, exist_ok=True)
        with open(outbox, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, sort_keys=True) + "\n")
    except OSError as exc:
        print(f"outbox-queue: could not append to {outbox}: {exc}", file=sys.stderr)
        return 5
    print(f"queued: outbox={outbox} kind={row.get('kind', 'progress')}", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
