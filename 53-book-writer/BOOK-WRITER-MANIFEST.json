  "source_prompt_pins_note": "sha256 of each baked NON-tone prompt asset (prompts/<stage>/{system,methodology,user}.md for stages 01-03, 10-14, 19-23, 41-45); populated by `qc-book-writer.sh --repin` after Wave-1 authors the triplets, then enforced by prove_bw_process (AF-BK-HASH-PIN) + book-writer-entry.sh. The five tone stages 04-08 are pinned separately and byte-exactly against shared-utils/tone-writing-core via verify_tone_core_sync.py (NOT listed here).",
  "modes": {
    "full": "the flagship 12-chapter book (source Book Writer, 153 nodes)",
    "4x3x3": "the offer book: 30 titles / 4 Transformational Outcomes / KP doc / 433_Deck_Data.json + deck outline handed to Skill 51 (source 4x3x3 w Book Writer, 121 nodes)"
  },
  "modes_note": "Anthology is the SEPARATE future sibling Skill 54 (anthology-writer); it is referenced only as a sibling and is NOT a mode here.",
  "gates_order": {
    "full": [
      "GATE-1-title",
      "GATE-2-outline",
      "GATE-3-approval",
      "GATE-4-approval-r2"
    ],
    "4x3x3": [
      "GATE-433",
      "GATE-1-title",
      "GATE-2-outline",
      "GATE-3-approval"
    ]
  },
  "gates_order_note": "In-chat human checkpoints replacing the source Gmail sendAndWait forms, exact order preserved: titles -> outline -> final approval -> (optional) second revision. Each gate receipt records the human's actual reply text + timestamp; downstream stage receipts reference the gate-receipt hash they depended on (approvals cannot be back-filled).",
  "tiers": {
    "HEAVY-WRITER": "client's strongest long-form model (their OpenRouter primary or ollama-cloud large model, maxTokens 65536, baseUrl required)",
    "MID-WRITER": "client's mid model",
    "FORMATTER": "client's fast structured-output model; all counting/assembly is Python, not LLM",
    "RESEARCHER": "client box's configured web-search tool + a MID composer; no search -> flagged degraded section + degraded:search receipt (never silent fabrication)",
    "IMAGE": "client's own image provider/key; none configured -> cover stage parks degraded:image and the book still delivers (the cover-prompt .md is always delivered)"
  },
  "tiers_note": "Capability tiers, NOT prescriptions. preflight.sh probes the client's configured providers and writes model-map.json + provider_caps. A client's express model choice is never substituted. NEVER Anthropic on any client box (AF-BK-ANTHROPIC).",
  "phases": [
    {
      "id": "P0-INTAKE",
      "order": 0,
      "name": "Intake + Book/Brand version selector (fail-closed, turn-gated)",
      "produces_artifact": "run/intake.json",
      "stages": [],
      "preflight": {
        "required": true,
        "checker": "_chk_intake",
        "label": "run/intake.json present and prove_bw_intake.py PASS — version=book explicit, mode in {full,4x3x3}, all required fields non-boilerplate, book_stories present (N/A allowed). version=brand hands off to Skill 52, never runs here."
      },
      "gate_codes": [
        "AF-BK-INTAKE-MISSING",
        "AF-BK-VERSION"
      ]
    },
    {
      "id": "P1-AVATAR",
      "order": 1,
      "name": "Avatar dossier (reconstructed Phase B)",
      "produces_artifact": "run/artifacts/01-avatar.md",
      "stages": [
        "01-avatar-questions-1-30",
        "02-avatar-questions-31-32",
        "03-rewrite-avatar"
      ],
      "preflight": {
        "required": true,
        "checker": "_chk_avatar",
        "label": "avatar dossier authored (stages 01-03); primary goal echoed."
      },
      "gate_codes": [
        "AF-BK-AVATAR-MISSING"
      ]
    },
    {
      "id": "P2-TONE",
      "order": 2,
      "name": "Tone: 4 style analyses + the blended 'The {First} {Last} Tone' (shared tone core)",
      "produces_artifact": "run/artifacts/08-blended-tone.md",
      "stages": [
        "04-tone-style-1",
        "05-tone-style-2",
        "06-tone-style-3",
        "07-tone-style-4",
        "08-blended-tone"
      ],
      "preflight": {
        "required": true,
        "checker": "_chk_tone",
        "label": "prove_bw_tone.py PASS — blended tone >= 3000 stripped words; tone stages 04-08 in lockstep with shared-utils/tone-writing-core (verify_tone_core_sync.py)."
      },
      "gate_codes": [
        "AF-BK-TONE-LEN"
      ]
    },
    {
      "id": "P3-TITLES-GATE",
      "order": 3,
      "name": "Suggested titles -> GATE-1 (client locks title + subtitle)",
      "produces_artifact": "run/artifacts/APPROVED-TITLE.txt",
      "stages": [
        "10-suggested-titles"
      ],
      "preflight": {
        "required": true,
        "checker": "_chk_title_lock",
        "label": "prove_bw_titlelock.py PASS — the GATE-1 locked title + subtitle appear byte-exact in every required downstream artifact."
      },
      "gate_codes": [
        "AF-BK-TITLE-LOCK"
      ]
    },
    {
      "id": "P4-OUTLINE-GATE",
      "order": 4,
      "name": "Blurb -> chapter titles -> outline -> GATE-2 (client approves outline)",
      "produces_artifact": "run/artifacts/13-outline.md",
      "stages": [
        "11-book-blurb",
        "12-chapter-titles",
        "13-create-outline",
        "14-rewrite-titles-extract"
      ],
      "preflight": {
        "required": true,
        "checker": "_chk_outline",
        "label": "prove_bw_stories.py PASS — each non-N/A personal story key phrase present in the approved outline; 12-title extraction schema-valid."
      },
      "gate_codes": [
        "AF-BK-STORIES"
      ]
    },
    {
      "id": "P5-CHAPTERS",
      "order": 5,
      "name": "Four STRICTLY-SEQUENTIAL chapter batches (continuity by design)",
      "produces_artifact": "run/chapters/ch01..ch12.md",
      "stages": [
        "15-write-chapters-b1",
        "16-write-chapters-b2",
        "17-write-chapters-b3",
        "18-write-chapters-b4"
      ],
      "preflight": {
        "required": true,
        "checker": "_chk_chapters",
        "label": "prove_bw_chapters.py PASS (exactly 12 chapters, each 2000-3500 stripped words) + prove_bw_continuity.py PASS (batch N receipt records sha256 of every prior chapter embedded) + prove_bw_stories.py PASS over the manuscript."
      },
      "gate_codes": [
        "AF-BK-CHAP-COUNT",
        "AF-BK-CHAP-LEN",
        "AF-BK-CONTINUITY",
        "AF-BK-STORIES"
      ]
    },
    {
      "id": "P6-PACKAGE",
      "order": 6,
      "name": "Assemble manuscript + 30-Day Challenge + cover prompt (+ optional revision rounds)",
      "produces_artifact": "delivery/<First>_<Last>-Book/",
      "stages": [
        "21-30day-challenge",
        "22-cover-prompt",
        "23-cover-image",
        "19-book-rewrite-1",
        "20-book-rewrite-2"
      ],
      "preflight": {
        "required": true,
        "checker": "check_package",
        "label": "prove_bw_challenge.py PASS (exactly 30 day-sections) + prove_bw_placeholder.py PASS (no unresolved {{..}}/$('..') tokens) + prove_bw_anon.py PASS (no configured client-name token, run over the assembled staging bundle) + the conditional GATE-3/GATE-4 revision-round approval receipts (required only when the corresponding rewrite round ran). Cover prompt always delivered; cover image may park degraded:image."
      },
      "gate_codes": [
        "AF-BK-CHALLENGE",
        "AF-BK-PLACEHOLDER",
        "AF-BK-ANON"
      ]
    },
    {
      "id": "P7-QC",
      "order": 7,
      "name": "QC battery (no-Anthropic + anonymization + 4x3x3 when applicable)",
      "produces_artifact": "run/qc/book_qc_report.json",
      "stages": [],
      "preflight": {
        "required": true,
        "checker": "check_qc",
        "label": "prove_bw_noanthropic.py PASS — RUN-LEDGER.json is PRESENT and records at least one model id (fail-closed when absent or empty), no /anthropic|claude/i model id, and no operator credential name in the LIVE run env (scanned by NAME only) + prove_bw_433.py PASS when mode=4x3x3. Anonymization (AF-BK-ANON) is enforced at P6-PACKAGE over the assembled bundle."
      },
      "gate_codes": [
        "AF-BK-ANTHROPIC",
        "AF-BK-433-COUNTS",
        "AF-BK-433-MAP"
      ]
    },
    {
      "id": "P8-DELIVER",
      "order": 8,
      "name": "Deliver (labeled local bundle + signed process certificate)",
      "produces_artifact": "delivery/<First>_<Last>-Book/PROCESS-CERTIFICATE.json",
      "stages": [],
      "preflight": {
        "required": true,
        "checker": "check_deliver",
        "label": "the certified staging bundle is promoted to delivery/ and copied to a labeled, timestamped ~/Downloads/<First>_<Last>-Book/Book_Writer_<timestamp>/ folder (root overridable via BOOK_WRITER_DELIVERY_ROOT), then EVERY file's sha256 is re-verified against MANIFEST.json (fail-closed on any missing/mismatched file); NO n8n / Airtable / Google / Gmail / Slack / GHL. An uncertified bundle is quarantined and never sits in delivery/. A signed process certificate is issued only after a full P0->P8 pass. 'Done' may only be claimed with the certificate path."
      },
      "gate_codes": [
        "AF-BK-STAGE-SKIPPED",
        "AF-BK-PROCESS-INTEGRITY"
      ]
    }
  ],
  "autofails": [
