      "enforced_by": "prove_bw_intake",
      "py_symbol": "evaluate"
    },
    {
      "code": "AF-BK-TITLE-LOCK",
      "stage": "P3-TITLES-GATE",
      "level": "manuscript",
      "trigger": "the GATE-1 locked title and/or subtitle is not present BYTE-EXACT in the blurb, outline, any chapter payload/title page, the manuscript title page, or the cover prompt (the source 'DO NOT CHANGE ABOVE TITLES' as code)",
