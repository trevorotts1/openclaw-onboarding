        "jsCode": "// Package for upload: carry the token, channel, metadata, and binary stats forward.\nconst verdict = $('Standing Gate - Verdict').first().json;\nconst oauth = $('Podbean OAuth - Token').first().json;\nconst bin = $input.first().binary || {};\nconst audio = bin.audio || {};\nreturn [{ json: {\n  access_token: oauth.access_token,\n  podcast_id: verdict.channel_id,\n  title: verdict.title,\n  description: verdict.description,\n  audioFilename: audio.fileName || 'draft-test.mp3',\n  audioFilesize: audio.fileSize || 0,\n}, binary: $input.first().binary }];"
