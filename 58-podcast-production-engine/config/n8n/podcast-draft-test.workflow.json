    {
      "parameters": {
        "jsCode": "// MULTIROW (two-show fleet model, 2026-08-03): channel-preferred row selection with legacy fallback.\n// Standing verdict + authoritative channel id. Fail closed.\nconst guard = $('Guard - Validate Payload').first().json;\nconst items = $input.all().map((i) => i.json).filter((r) => r && Object.keys(r).length > 0 && !r.error);\nif (!items.length) return [{ json: { ok: false, reason: 'identity_unknown' } }];\nconst row = (guard.payload_podcast_id ? items.find(r => String(r.podbean_channel_id || '').trim() === guard.payload_podcast_id) : null) || items[0];\nif (String(row.good_standing || '').toUpperCase() !== 'YES') return [{ json: { ok: false, reason: 'not_in_good_standing' } }];\nconst channel = row.podbean_channel_id || '';\nif (!channel) return [{ json: { ok: false, reason: 'no_channel_on_roster' } }];\nif (guard.payload_podcast_id && guard.payload_podcast_id !== channel) {\n  return [{ json: { ok: false, reason: 'channel_mismatch', roster_channel: channel } }];\n}\nreturn [{ json: { ok: true, channel_id: channel, title: guard.title, description: guard.description, audio_url: guard.audio_url } }];"
      },
