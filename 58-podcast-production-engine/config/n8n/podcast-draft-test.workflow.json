      "parameters": {
        "jsCode": "// Guard: validate the draft-test payload. Identity + audio_url required.\n// The roster row's podbean_channel_id is AUTHORITATIVE for the target channel;\n// a payload podcast_id is only cross-checked against it.\nconst wh = $('Webhook - Draft Test').first().json;\nconst body = wh.body || wh;\nconst missing = ['client_last_name','client_email','audio_url'].filter((k) => !body[k]);\nif (missing.length) {\n  return [{ json: { ok: false, reason: 'missing_fields', missing } }];\n}\nreturn [{ json: {\n  ok: true,\n  client_last_name: String(body.client_last_name).trim(),\n  client_email: String(body.client_email).toLowerCase().trim(),\n  audio_url: body.audio_url,\n  title: body.title || '[DRAFT TEST] safe verification - never published',\n  description: body.description || 'Automated draft-test episode. Created, verified, and deleted by the n8n podcast-draft-test workflow. Never appears on the live feed.',\n  payload_podcast_id: body.podcast_id || '',\n} }];"
      },
