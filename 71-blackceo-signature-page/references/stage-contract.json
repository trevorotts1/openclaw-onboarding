{
  "version": 1,
  "description": "Skill 71 mandatory stage contract. scripts/stage_gate.py is the only enforcer: no stage starts until check exits 0, no stage closes until close exits 0. Stage IDs are canonical; a run order or prompt cannot remove or rename them.",
  "stage_order": [
    "intake",
    "copy",
    "font-action-plan",
    "desktop-wireframe",
    "mobile-tablet",
    "visual-mockup",
    "image-inventory-prompts",
    "image-generation-qc",
    "image-map-upload",
    "final-mockups",
    "responsive-html",
    "ghl-install-test",
    "publish-verify",
    "automation-wiring"
  ],
  "stages": {
    "intake": {
      "depends_on": [],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "intake.json",
          "min_count": 1
        }
      ],
      "validators": [
        "gate:must_supply --brand {brand}",
        "gate:intake_engine"
      ],
      "review_required": false,
      "min_scores": null,
      "reads": [
        "references/BlackCEO-Page-Brand-Law.md",
        "references/BlackCEO-Signature-Landing-Page-Production-and-QC-SOP-v1.md",
        "references/artifact-contracts.md"
      ],
      "may_be_not_authorized": false
    },
    "copy": {
      "depends_on": [
        "intake"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "copy/internal-manuscript.md",
          "min_count": 1
        },
        {
          "glob": "copy/public-copy.md",
          "min_count": 1
        },
        {
          "glob": "copy/copy-manifest.json",
          "min_count": 1
        }
      ],
      "validators": [
        "python3 scripts/validate_copy_structure.py {run_dir} --spec references/copy-specs/{copy_version}-v6.json",
        "python3 scripts/validate_public_copy.py {run_dir}/copy/public-copy.md"
      ],
      "review_required": true,
      "min_scores": {
        "each": 8
      },
      "copy_selection": {
        "intake_field": "copy_version",
        "required": true,
        "note": "Exactly ONE guide governs copy structure, selected by the run's intake copy_version (Amendment 6, Items 18/19). The selected guide's copy spec and emotional-quality extract are read with it. The Production and QC SOP and the Image Intelligence Guide v5 stay in reads as linked documents; they govern their own layers and do not override the selected guide on copy structure. The copy stage receipt records the selection as copy_selection {copy_version, guide, spec, emotional_quality} (documented in references/artifact-contracts.md).",
        "values": {
          "standard": {
            "guide": "references/BlackCEO-Signature-Landing-Page-Standard-v6.md",
            "spec": "references/copy-specs/standard-v6.json",
            "emotional_quality": "references/copy-specs/standard-emotional-quality.md"
          },
          "long-form": {
            "guide": "references/BlackCEO-Signature-Landing-Page-Long-Form-v6.md",
            "spec": "references/copy-specs/long-form-v6.json",
            "emotional_quality": "references/copy-specs/long-form-emotional-quality.md"
          }
        }
      },
      "reads": [
        "references/BlackCEO-Page-Brand-Law.md",
        "references/BlackCEO-Signature-Landing-Page-Production-and-QC-SOP-v1.md (linked document: governs production and QC layers, not copy structure)",
        "references/BlackCEO-Signature-Image-Intelligence-and-Prompt-Creation-Guide-v5.md (linked document: governs the image layer, not copy structure)",
        "the ONE selected copy guide, per copy_selection (intake copy_version): references/BlackCEO-Signature-Landing-Page-Standard-v6.md or references/BlackCEO-Signature-Landing-Page-Long-Form-v6.md",
        "the selected guide's copy spec, per copy_selection: references/copy-specs/standard-v6.json or references/copy-specs/long-form-v6.json",
        "the selected guide's emotional-quality chapter extract, per copy_selection: references/copy-specs/standard-emotional-quality.md or references/copy-specs/long-form-emotional-quality.md",
        "copy/internal-manuscript.md",
        "copy/public-copy.md"
      ],
      "may_be_not_authorized": false
    },
    "font-action-plan": {
      "depends_on": [
        "copy"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "font-action-plan/font-map.json",
          "min_count": 1
        },
        {
          "glob": "font-action-plan/action-plan.md",
          "min_count": 1
        }
      ],
      "validators": [
        "gate:brand_fonts --font-map {run_dir}/font-action-plan/font-map.json --brand {brand}"
      ],
      "review_required": false,
      "min_scores": null,
      "reads": [
        "references/BlackCEO-Signature-Landing-Page-Production-and-QC-SOP-v1.md",
        "references/BlackCEO-Page-Brand-Law.md",
        "assets/brand/blackceo-brand.json"
      ],
      "may_be_not_authorized": false
    },
    "desktop-wireframe": {
      "depends_on": [
        "font-action-plan"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "desktop-wireframe/part-*.png",
          "min_count": 1
        },
        {
          "glob": "desktop-wireframe/image-inventory.json",
          "min_count": 1
        },
        {
          "glob": "desktop-wireframe/section-plan.json",
          "min_count": 1
        }
      ],
      "validators": [
        "python3 scripts/validate_wireframe.py {run_dir} desktop-wireframe"
      ],
      "review_required": true,
      "min_scores": {
        "each": 8
      },
      "reads": [
        "references/BlackCEO-Signature-Landing-Page-Production-and-QC-SOP-v1.md",
        "references/BlackCEO-Page-Brand-Law.md",
        "font-action-plan/font-map.json",
        "assets/page-references/README.md (the layout reference index: the run's layout references are recorded there per Item 13)"
      ],
      "may_be_not_authorized": false
    },
    "mobile-tablet": {
      "depends_on": [
        "desktop-wireframe"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "mobile-tablet/part-*.png",
          "min_count": 1
        },
        {
          "glob": "mobile-tablet/tablet-rules.md",
          "min_count": 1
        },
        {
          "glob": "mobile-tablet/section-plan.json",
          "min_count": 1
        }
      ],
      "validators": [
        "python3 scripts/validate_wireframe.py {run_dir} mobile-tablet"
      ],
      "review_required": true,
      "min_scores": {
        "each": 8
      },
      "reads": [
        "references/BlackCEO-Signature-Landing-Page-Production-and-QC-SOP-v1.md",
        "references/BlackCEO-Page-Brand-Law.md",
        "font-action-plan/font-map.json",
        "assets/page-references/README.md (the layout reference index: the run's layout references are recorded there per Item 13)"
      ],
      "may_be_not_authorized": false
    },
    "visual-mockup": {
      "depends_on": [
        "mobile-tablet"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "visual-mockup/page-visual-bible.json",
          "min_count": 1
        },
        {
          "glob": "visual-mockup/mockup.html",
          "min_count": 1
        },
        {
          "glob": "visual-mockup/desktop/part-*.png",
          "min_count": 1
        },
        {
          "glob": "visual-mockup/mobile/part-*.png",
          "min_count": 1
        }
      ],
      "validators": [
        "python3 scripts/validate_visual_direction.py {run_dir}",
        "python3 scripts/validate_page.py {run_dir}/visual-mockup/mockup.html --brand {brand} --mode mockup --run-dir {run_dir}"
      ],
      "review_required": true,
      "review_covers": [
        "visual-mockup/desktop/part-*.png",
        "visual-mockup/mobile/part-*.png",
        "visual-mockup/mockup.html",
        "visual-mockup/page-visual-bible.*"
      ],
      "min_scores": {
        "each": 8
      },
      "reads": [
        "references/BlackCEO-Page-Brand-Law.md",
        "assets/brand/blackceo-brand.json",
        "assets/brand/signature-grade-block.txt",
        "desktop-wireframe/",
        "mobile-tablet/",
        "the layout references recorded in assets/page-references/README.md (Item 13)"
      ],
      "may_be_not_authorized": false
    },
    "image-inventory-prompts": {
      "itemized": true,
      "depends_on": [
        "mobile-tablet"
      ],
      "requires_artifacts": [
        "visual-mockup/page-visual-bible.json"
      ],
      "artifacts": [
        {
          "glob": "image-inventory-prompts/IMG-*.txt",
          "min_count": 1
        },
        {
          "glob": "image-inventory-prompts/prompt-manifest.json",
          "min_count": 1
        }
      ],
      "per_file_glob": "image-inventory-prompts/IMG-*.txt",
      "count_of": "desktop-wireframe/image-inventory.json",
      "count_glob": "image-inventory-prompts/IMG-*.txt",
      "validators": [
        "python3 scripts/validate_prompt.py {file} {sauce}"
      ],
      "review_required": true,
      "min_scores": {
        "each": 8,
        "average": 8.5
      },
      "reads": [
        "references/BlackCEO-Signature-Image-Intelligence-and-Prompt-Creation-Guide-v5.md",
        "references/kie-generation-route.md",
        "references/BlackCEO-Page-Brand-Law.md",
        "assets/brand/blackceo-brand.json",
        "assets/brand/signature-grade-block.txt"
      ],
      "may_be_not_authorized": false
    },
    "image-generation-qc": {
      "itemized": true,
      "depends_on": [
        "image-inventory-prompts"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "image-generation-qc/Image-*.png",
          "min_count": 1
        },
        {
          "glob": "image-generation-qc/image-qc.json",
          "min_count": 1
        }
      ],
      "per_file_glob": "image-generation-qc/Image-*.png",
      "count_of": "desktop-wireframe/image-inventory.json",
      "count_glob": "image-generation-qc/Image-*.png",
      "cost_required": true,
      "transport_required": true,
      "validators": [
        "python3 scripts/validate_image_grade.py {file} --brand {brand}",
        "gate:image_grade_full_set image-generation-qc",
        "gate:grade_calibrated"
      ],
      "review_required": true,
      "min_scores": {
        "each": 8,
        "average": 8.5
      },
      "reads": [
        "references/BlackCEO-Signature-Image-Intelligence-and-Prompt-Creation-Guide-v5.md",
        "references/kie-generation-route.md",
        "references/BlackCEO-Page-Brand-Law.md",
        "assets/brand/blackceo-brand.json"
      ],
      "may_be_not_authorized": false
    },
    "image-map-upload": {
      "depends_on": [
        "image-generation-qc"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "image-map-upload/image-map.json",
          "min_count": 1
        },
        {
          "glob": "image-map-upload/image-map.md",
          "min_count": 1
        }
      ],
      "validators": [
        "python3 scripts/validate_image_manifest.py {run_dir}/image-map-upload/image-map.json --inventory {run_dir}/desktop-wireframe/image-inventory.json --measure --check-files"
      ],
      "review_required": false,
      "min_scores": null,
      "reads": [
        "references/artifact-contracts.md",
        "references/BlackCEO-Signature-Landing-Page-Production-and-QC-SOP-v1.md"
      ],
      "may_be_not_authorized": false
    },
    "final-mockups": {
      "depends_on": [
        "visual-mockup",
        "image-map-upload"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "final-mockups/mockup.html",
          "min_count": 1
        },
        {
          "glob": "final-mockups/desktop/part-*.png",
          "min_count": 1
        },
        {
          "glob": "final-mockups/mobile/part-*.png",
          "min_count": 1
        }
      ],
      "validators": [
        "python3 scripts/validate_page.py {run_dir}/final-mockups/mockup.html --brand {brand} --mode mockup --run-dir {run_dir}"
      ],
      "review_required": true,
      "review_covers": [
        "final-mockups/desktop/part-*.png",
        "final-mockups/mobile/part-*.png",
        "final-mockups/mockup.html"
      ],
      "min_scores": {
        "each": 8
      },
      "reads": [
        "references/BlackCEO-Page-Brand-Law.md",
        "assets/brand/blackceo-brand.json",
        "visual-mockup/mockup.html",
        "image-map-upload/image-map.json"
      ],
      "may_be_not_authorized": false
    },
    "responsive-html": {
      "depends_on": [
        "final-mockups"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "responsive-html/index.html",
          "min_count": 1
        },
        {
          "glob": "responsive-html/page.txt",
          "min_count": 1
        },
        {
          "glob": "responsive-html/compare/*.png",
          "min_count": 1
        }
      ],
      "validators": [
        "python3 scripts/validate_page.py {run_dir}/responsive-html/index.html --brand {brand} --mode page --run-dir {run_dir}",
        "python3 scripts/compare_sheet.py {run_dir}"
      ],
      "review_required": true,
      "review_covers": "responsive-html/compare/*.png",
      "min_scores": {
        "each": 8
      },
      "reads": [
        "references/BlackCEO-Page-Brand-Law.md",
        "assets/brand/blackceo-brand.json",
        "final-mockups/mockup.html",
        "image-map-upload/image-map.json",
        "copy/public-copy.md",
        "font-action-plan/font-map.json",
        "references/html-qc-rubric.md"
      ],
      "may_be_not_authorized": false
    },
    "ghl-install-test": {
      "uses_browser": true,
      "depends_on": [
        "responsive-html"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "ghl-install-test/install-steps.md",
          "min_count": 1
        },
        {
          "glob": "ghl-install-test/funnel-completion.json",
          "min_count": 1
        },
        {
          "glob": "ghl-install-test/evidence/desktop.png",
          "min_count": 1
        },
        {
          "glob": "ghl-install-test/evidence/mobile.png",
          "min_count": 1
        },
        {
          "glob": "ghl-install-test/browser-hygiene.json",
          "min_count": 1
        }
      ],
      "validators": [
        "python3 scripts/validate_install.py {run_dir} install",
        "python3 scripts/validate_funnel_completion.py {run_dir}"
      ],
      "review_required": false,
      "min_scores": null,
      "reads": [
        "references/BlackCEO-Signature-Landing-Page-Production-and-QC-SOP-v1.md",
        "responsive-html/page.txt",
        "references/funnel-completion-checklist.md",
        "references/browser-engine-contract.md",
        "references/automation-handoff.md"
      ],
      "may_be_not_authorized": true,
      "sub_stages": [
        {
          "id": "funnel-completion",
          "required_when": "intake.publish_target == \"ghl\" or any funnel step binds an externally hosted page by embed",
          "receipt": "ghl-install-test/funnel-completion.json",
          "validator": "python3 scripts/validate_funnel_completion.py {run_dir}",
          "checklist": "references/funnel-completion-checklist.md"
        }
      ]
    },
    "publish-verify": {
      "uses_browser": true,
      "depends_on": [
        "ghl-install-test"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "publish-verify/receipts/*",
          "min_count": 1
        },
        {
          "glob": "publish-verify/fetch-record.json",
          "min_count": 1
        },
        {
          "glob": "publish-verify/browser-hygiene.json",
          "min_count": 1
        }
      ],
      "validators": [
        "python3 scripts/validate_install.py {run_dir} publish"
      ],
      "review_required": false,
      "min_scores": null,
      "reads": [
        "references/BlackCEO-Signature-Landing-Page-Production-and-QC-SOP-v1.md",
        "references/automation-handoff.md",
        "references/deliverables-manifest.md"
      ],
      "may_be_not_authorized": true
    },
    "automation-wiring": {
      "depends_on": [
        "publish-verify"
      ],
      "requires_artifacts": [],
      "artifacts": [
        {
          "glob": "automation-wiring/checklist-*.md",
          "min_count": 1
        },
        {
          "glob": "automation-wiring/browser-hygiene.json",
          "min_count": 1
        }
      ],
      "validators": [],
      "review_required": true,
      "min_scores": {
        "each": 8
      },
      "review_covers": "stage",
      "reads": [
        "references/automation-handoff.md",
        "references/funnel-completion-checklist.md",
        "handoff/automation-handoff.json",
        "references/BlackCEO-Signature-Landing-Page-Production-and-QC-SOP-v1.md"
      ],
      "may_be_not_authorized": false,
      "conditional": {
        "required_when": "intake.publish_target == \"ghl\" and intake.automation_scope == \"workflows\"",
        "otherwise": "the gate records the stage not_applicable in state and REPORT.md, citing the intake values"
      },
      "uses_browser": true
    }
  }
}
