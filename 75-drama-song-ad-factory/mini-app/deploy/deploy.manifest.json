{
  "schema": "blackceo.mini-app-deploy/v1",
  "unit": "U4",
  "service_home": "75-drama-song-ad-factory/mini-app/",
  "owned_source": "deploy/",
  "_note": "Deploy-side manifest for the Drama Studio mini-app. No real Cloudflare id, token or secret value belongs in this file: the wrangler config keeps <PLACEHOLDER> ids and deploy.sh resolves them into a throwaway /tmp config at deploy time. U2 owns worker/ (service), U3 owns pages/ (UI); this manifest and deploy.sh own deploy/ only.",
  "cloudflare": {
    "intended_account_label": "BlackCEO",
    "intended_zone_name": "zerohumanworkforce.com",
    "api_base": "https://api.cloudflare.com/client/v4"
  },
  "worker": {
    "name": "drama-studio-mini-app",
    "route_host": "studio.zerohumanworkforce.com",
    "main": "src/index.js",
    "compatibility_date": "2024-09-23"
  },
  "bucket": {
    "name": "zhw-drama-studio",
    "retention_days": 45,
    "retention_prefix": "projects/"
  },
  "secrets": [
    { "name": "R2_ACCESS_KEY_ID", "value_source": "env" },
    { "name": "R2_SECRET_ACCESS_KEY", "value_source": "env" }
  ],
  "env": {
    "token_var": "CLOUDFLARE_DRAMA_STUDIO_API_TOKEN",
    "wrangler_toml": "worker/wrangler.toml",
    "schema_sql": "worker/schema.sql"
  }
}
