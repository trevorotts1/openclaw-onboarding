{"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "description": "Single artifact record. Stable IDs per section 21; stale-flag invalidation per section 22; provenance per section 24.4.", "properties": {"artifact_id": {"minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "type": "string"}, "kind": {"enum": ["audio", "image", "video", "text", "json", "manifest", "receipt", "timeline", "captions", "overlay"], "type": "string"}, "path": {"description": "Repo-relative normalized path inside approved storage.", "minLength": 1, "type": "string"}, "provenance": {"additionalProperties": false, "properties": {"model": {"type": "string"}, "provider": {"type": "string"}, "receipt_path": {"type": "string"}, "task_id": {"type": "string"}}, "type": "object"}, "run_id": {"minLength": 1, "type": "string"}, "schema_version": {"const": "1.0.0", "type": "string"}, "sha256": {"minLength": 64, "pattern": "^[0-9a-f]{64}$", "type": "string"}, "stage": {"enum": ["intake", "preflight", "music", "continuity", "storyboard", "generation", "edit", "qc", "variants", "delivery"], "type": "string"}, "stale": {"description": "True when an upstream change invalidated this artifact. Stale artifacts must not be consumed.", "type": "boolean"}, "supersedes": {"description": "artifact_id this record replaces, or null.", "type": ["string", "null"]}, "version": {"minimum": 1, "type": "integer"}}, "required": ["schema_version", "artifact_id", "run_id", "stage", "kind", "path", "sha256"], "title": "artifact-schema", "type": "object"}
