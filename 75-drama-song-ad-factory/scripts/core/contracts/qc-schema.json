{"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "description": "Mandatory QC verdict record. Verdicts PASS/FAIL/UNAVAILABLE per 17.8: UNAVAILABLE cannot become PASS; no aggregate average erases a critical defect. Reviewer must be independent of the maker per 17.6/24.4: a caller-supplied PASS flag or maker-authored JSON is not review evidence.", "properties": {"check": {"enum": ["export", "timeline", "lyrics", "timing", "audio", "text_product", "continuity", "creative", "song", "storyboard", "video", "final_edit", "delivery_checklist"], "type": "string"}, "check_id": {"minLength": 1, "type": "string"}, "checker_version": {"minLength": 1, "type": "string"}, "evidence": {"additionalProperties": false, "properties": {"refs": {"items": {"type": "string"}, "type": "array"}, "summary": {"minLength": 1, "type": "string"}}, "required": ["summary"], "type": "object"}, "reason_code": {"type": "string"}, "reviewer": {"additionalProperties": false, "description": "Independent reviewer identity bound to this verdict.", "properties": {"authority": {"type": "string"}, "identity": {"type": "string"}, "session": {"type": "string"}}, "required": ["identity"], "type": "object"}, "run_id": {"minLength": 1, "type": "string"}, "schema_version": {"const": "1.0.0", "type": "string"}, "stage": {"type": "string"}, "timing_detail": {"additionalProperties": false, "description": "Required when check=timing. Sample, confidence and annotation method recorded per 17.8.", "properties": {"annotation_method": {"type": "string"}, "confidence": {"type": "string"}, "critical_max_ms": {"type": "number"}, "median_ms": {"type": "number"}, "p95_ms": {"type": "number"}, "sample_ref": {"type": "string"}}, "type": "object"}, "verdict": {"enum": ["FAIL", "PASS", "UNAVAILABLE"], "type": "string"}}, "required": ["schema_version", "check_id", "run_id", "stage", "check", "verdict", "evidence", "checker_version", "reviewer"], "title": "qc-schema", "type": "object"}
