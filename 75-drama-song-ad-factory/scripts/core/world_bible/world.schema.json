{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "world_bible/world.schema.json",
  "title": "episode-world",
  "description": "Early episode world (S75-T08). Authored before script and music; holds locations, light, palette, texture, era, sound and a never-list. Reusable character identity lives elsewhere and is referenced by ID only.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "kind", "artifact_id", "run_id", "revision",
    "premise", "fiction_classification", "era", "locations", "light",
    "palette", "texture", "sound", "never_list", "cast_refs", "continuity",
    "content_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "episode_world"},
    "artifact_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "previous_revision": {"type": "integer", "minimum": 1},
    "change_reason": {"type": "string"},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provenance": {"type": "object"},
    "dependencies": {"type": "object"},
    "premise": {"type": "string", "minLength": 1},
    "fiction_classification": {"enum": ["proposed_fiction", "sourced"]},
    "era": {
      "type": "object",
      "required": ["period", "time_of_day", "time_jumps"],
      "properties": {
        "period": {"type": "string", "minLength": 1},
        "time_of_day": {"type": "string", "minLength": 1},
        "season_weather": {"type": "string"},
        "time_jumps": {"type": "array", "items": {"type": "object"}}
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["location_id", "name", "function", "interior"],
        "properties": {
          "location_id": {"type": "string", "pattern": "^loc_[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "name": {"type": "string", "minLength": 1},
          "function": {"type": "string", "minLength": 1},
          "interior": {"type": "boolean"},
          "access": {"type": "string"},
          "entrances": {"type": "array", "items": {"type": "string"}},
          "geography": {"type": "string"}
        }
      }
    },
    "light": {
      "type": "object",
      "required": ["doctrine", "sources"],
      "properties": {
        "doctrine": {"type": "string", "minLength": 1},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source", "direction"],
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "direction": {"type": "string", "minLength": 1},
              "motivated_change": {"type": "string"}
            }
          }
        }
      }
    },
    "palette": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "texture": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sound": {
      "type": "object",
      "required": ["ambience"],
      "properties": {
        "ambience": {"type": "string", "minLength": 1},
        "off_screen": {"type": "array", "items": {"type": "string"}},
        "silence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "never_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "cast_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["character_id", "identity_revision"],
        "additionalProperties": false,
        "properties": {
          "character_id": {"type": "string", "minLength": 1},
          "identity_revision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "continuity": {
      "type": "object",
      "required": ["must_persist"],
      "properties": {
        "must_persist": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "may_change": {"type": "array", "items": {"type": "string"}},
        "exceptions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scene_id", "location_id"],
        "properties": {
          "scene_id": {"type": "string", "minLength": 1},
          "location_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
