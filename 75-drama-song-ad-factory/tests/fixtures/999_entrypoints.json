  "skill_root_anchor": ".claude/skills/drama-song-ad-factory",
  "contract": "Every step below is advertised by the 999 normal entrypoint and is EXERCISED with its required arguments by package/999_adapter.py check. A recorded exit code is a measurement, not a claim: the advertised check re-runs each step and compares the real code. An advertised_in citation names a file and a line in this tree; the check opens that line and fails when the quoted text is not on it. A step that cannot run sits in excluded_steps and its claim is re-run on every check, so a command that really runs fails.",

  "invocation_rules": [
    "The token {python} is substituted with the interpreter running the consumer.",
    "The token {work} is substituted with a fresh temporary directory, seeded from workdir_files, so every argv is complete as written and repeatable.",
    "The factory CLI is invoked with the default sys.path (python3 script.py), which is the form its own relative-import fallback needs.",
    "Every argv is complete: no ellipsis, no optional-step shorthand, no unrun --help probe standing in for a real invocation."
  ],

  "observer": {
    "repository": "https://github.com/trevorotts1/999-setup.git",
