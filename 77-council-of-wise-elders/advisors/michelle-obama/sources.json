          },
          "kind": "concept",
          "mark": "paraphrase",
          "original_speaker": null,
          "excerpt": null,
          "paraphrase": "The Box-Checker Trap: \"I lived like a half-closeted CEO... bent on checking every box.\" This leads to emptiness and burnout.",
          "claim_ids": [],
          "seat_id": "michelle-obama"
        },
        {
          "evidence_id": "ev-michelle-obama-becoming-c016",
          "source_id": "src-michelle-obama-becoming",
