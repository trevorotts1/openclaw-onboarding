            "value": "item 19: The Amateur-to-Expert Gap"
          },
          "kind": "concept",
          "mark": "paraphrase",
          "original_speaker": null,
          "excerpt": null,
          "paraphrase": "1. Preparation Depth: Amateurs wing it; experts rehearse \"again and again\" and have their schedulers drive routes in advance to time transit to the minute.",
          "claim_ids": [],
          "seat_id": "michelle-obama"
        },
        {
          "evidence_id": "ev-michelle-obama-becoming-c020",
          "source_id": "src-michelle-obama-becoming",
          "source_version": "e264bffae8e88954fb6adc830caa8526a72a910e6b18570684d5a758d6d2a3dc",
