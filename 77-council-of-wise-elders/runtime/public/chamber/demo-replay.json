  "brief": {
   "question": "Should we launch a done-for-you AI workforce tier at $2,500 a month?",
   "options": [
    {
     "id": "A",
     "label": "Launch to all clients in January",
     "kind": "change"
    },
    {
     "id": "B",
     "label": "Pilot with 10 clients first",
     "kind": "bounded_test"
    },
    {
     "id": "C",
     "label": "Keep the current offer, revisit in Q2",
     "kind": "status_quo"
    },
    {
     "id": "D",
     "label": "Launch only with a 90-day money-back guarantee",
     "kind": "other"
    }
   ]
