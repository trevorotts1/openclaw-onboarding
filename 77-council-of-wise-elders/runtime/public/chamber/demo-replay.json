  },
  {
   "card_kind": "ratification",
   "seat_id": "td-jakes",
   "round": 3,
   "stance": "support",
   "preferred_option_id": "B",
   "resolution_stance": "support",
   "unresolved_objections": [
    "Tell the story of the pilot publicly so it reads as momentum, not hesitation."
   ],
   "amendments": []
  },
  {
   "card_kind": "ratification",
   "seat_id": "oprah-winfrey",
   "round": 3,
