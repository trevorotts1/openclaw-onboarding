          "expect": {
            "ok": true,
            "status": "active"
          }
        },
        {
          "do": "resolve",
          "expect": {
            "found": true,
            "ok": true,
            "status": "active"
          }
        },
        {
          "do": "admit",
          "expect": {
            "ok": true,
            "replayed": false
          },
          "operation_id": "op-1"
        },
        {
          "do": "admit",
          "expect": {
            "ok": true,
            "replayed": true
          },
          "operation_id": "op-1"
        },
        {
          "do": "count_reservations",
          "expect": {
            "count": 1,
            "ok": true
          }
        },
        {
          "do": "consume",
          "expect": {
            "ok": true
          },
          "operation_id": "op-1",
          "outcome": "settled"
