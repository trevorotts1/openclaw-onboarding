{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wise-elders.hybrid-supervisor-policy/v2",
  "title": "wise-elders.hybrid-supervisor-policy/v2",
  "description": "Versioned Hybrid Council of Wise Elders supervisor policy schema (document_version 2.4, exact field set of the v2.4 plan's embedded policy example). binding_status TEMPLATE_NOT_BOUND: no native-adapter binding is asserted here; that binding is a later unit. Values are pinned with const so a drifting policy file fails validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "full_sweep_interval_seconds",
    "health_tick_seconds",
    "heartbeat_suspect_after_seconds",
    "max_concurrent_workflows",
    "max_agents_per_workflow",
    "max_total_agents",
    "require_independent_non_author_review",
    "require_exact_head_checks",
    "require_atomic_expected_head_merge_guard",
    "standing_repository_merge_authorized",
    "vercel_required",
    "cloudflare_build_required",
    "customer_remote_access_opt_in",
    "explicit_stop_disables_automatic_engineering_restart",
    "binding_status",
    "document_version"
  ],
  "properties": {
    "full_sweep_interval_seconds": { "const": 600 },
    "health_tick_seconds": { "const": 60 },
    "heartbeat_suspect_after_seconds": { "const": 180 },
    "max_concurrent_workflows": { "const": 50 },
    "max_agents_per_workflow": { "const": 10 },
    "max_total_agents": { "const": 500 },
    "require_independent_non_author_review": { "const": true },
    "require_exact_head_checks": { "const": true },
    "require_atomic_expected_head_merge_guard": { "const": true },
    "standing_repository_merge_authorized": { "const": true },
    "vercel_required": { "const": false },
    "cloudflare_build_required": { "const": true },
    "customer_remote_access_opt_in": { "const": true },
    "explicit_stop_disables_automatic_engineering_restart": { "const": true },
    "binding_status": { "const": "TEMPLATE_NOT_BOUND" },
    "document_version": { "const": "2.4" }
  }
}
