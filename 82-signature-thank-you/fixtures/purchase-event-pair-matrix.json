      "right": "main_bump_12",
      "why": "1.2 acceptance produces the identical snapshot as 1.0 for the same content."
    },
    {
      "case_id": "eq-1.0-vs-1.2-extra-same-order-parent-string",
      "kind": "equivalence",
      "left": "main_bump_u1_same_order_10",
      "right": "main_bump_u1_same_order_12_parent_string",
      "why": "A parent_order_ref string on a later extra event changes nothing in the merged snapshot."
    },
    {
      "case_id": "eq-parent-string-vs-null",
      "kind": "equivalence",
      "left": "main_bump_u1_same_order_12_parent_string",
      "right": "main_bump_u1_parent_null_12",
      "why": "String and null parent_order_ref forms are equivalent: the field is not an identity."
    },
    {
      "case_id": "eq-parent-string-vs-absent",
