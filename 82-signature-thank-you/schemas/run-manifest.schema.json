{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Per fulfilled purchase resolution, S82 emits this manifest alongside (never inside) the thank-you result document. It carries the two result-side facts page-result 1.0 needs that the result document does not: the run's independent-review facts and the native bindings the resolution consumed, plus provenance for both inputs. Nulls are explicit and honest: a fact the run does not have is null, never invented. Status 'none' requires all review facts null; status 'recorded' requires all three present.","properties":{"independent_review":{"additionalProperties":false,"allOf":[{"if":{"properties":{"status":{"const":"none"}},"required":["status"]},"then":{"properties":{"record_ref":{"type":"null"},"reviewer":{"type":"null"},"verdict":{"type":"null"}}}},{"if":{"properties":{"status":{"const":"recorded"}},"required":["status"]},"then":{"properties":{"record_ref":{"type":"string"},"reviewer":{"type":"string"},"verdict":{"type":"string"}}}}],"properties":{"record_ref":{"minLength":1,"type":["string","null"]},"reviewer":{"minLength":1,"type":["string","null"]},"status":{"enum":["none","recorded"]},"verdict":{"minLength":1,"type":["string","null"]}},"required":["status","reviewer","verdict","record_ref"],"type":"object"},"launch_id":{"minLength":1,"type":"string"},"location_id":{"minLength":1,"type":"string"},"manifest_version":{"const":"1.0"},"native_bindings_ref":{"additionalProperties":false,"properties":{"entitlement_version":{"pattern":"^ev1:[0-9a-f]{64}$","type":["string","null"]},"envelope_ref":{"minLength":1,"type":["string","null"]}},"required":["envelope_ref","entitlement_version"],"type":"object"},"provenance":{"additionalProperties":false,"properties":{"map_ref":{"minLength":1,"type":["string","null"]},"snapshot_ref":{"minLength":1,"type":["string","null"]}},"required":["snapshot_ref","map_ref"],"type":"object"},"result_ref":{"minLength":1,"type":"string"},"tenant_id":{"minLength":1,"type":"string"},"test_only":{"type":"boolean"}},"required":["manifest_version","tenant_id","location_id","launch_id","test_only","result_ref","independent_review","native_bindings_ref","provenance"],"title":"Thank-you run manifest (CR-S49-004 Path B companion to the thank-you result document)","type":"object"}