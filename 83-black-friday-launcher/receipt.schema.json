{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "83-black-friday-launcher/receipt.schema.json",
  "title": "Black Friday Launcher package receipt (typed per-unit, v1.1)",
  "description": "The receipt this skill writes beside package-manifest.json. Every delivered unit gets its own typed row bound to tenant, location, launch, revision and the approved plan hash. A row proves itself with artifact bytes (path + sha256 + size), the request it answers and the lane that validated it; proof classes are separate booleans so authored, draft-installed, tested and live-verified evidence can never be read as one another. Validated by launcher_core/checks.py at package check and again on recovery (verify_package_receipt).",
  "type": "object",
  "required": [
    "schema_version",
    "receipt_type",
    "receipt_schema",
    "receipt_id",
    "tenant_id",
    "location_id",
    "launch_id",
    "revision",
    "approved_plan_hash",
    "assembled_at",
    "manifest",
    "units",
    "lane_validations",
    "receipt_evidence",
    "live_effects"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.1"},
    "receipt_type": {"type": "string", "const": "launcher.package.v1"},
    "receipt_schema": {"type": "string", "const": "receipt.schema.json"},
    "receipt_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "location_id": {"type": "string", "minLength": 1},
    "launch_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "approved_plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assembled_at": {"type": "string", "minLength": 1},
    "manifest": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "const": "package-manifest.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/unit_receipt"}
    },
    "lane_validations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lane", "contract", "state"],
        "properties": {
          "lane": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1},
          "state": {"type": "string", "enum": ["passed", "recorded", "not_applicable"]},
          "detail": {"type": "string"}
        }
      }
    },
    "receipt_evidence": {
      "type": "object",
      "required": ["store", "state"],
      "properties": {
        "store": {"type": "string", "minLength": 1},
        "state": {"type": "string", "enum": ["verified", "absent"]}
      }
    },
    "live_effects": {"type": "string", "pattern": "^(none|paid_image_renders:[0-9]+)$"},
    "activation": {"$ref": "#/definitions/activation_record"},
    "activation_label": {"type": "string", "minLength": 1},
    "launch_plan": {"type": ["object", "null"]}
  },
  "definitions": {
    "activation_record": {
      "type": "object",
      "description": "F06: the stage this package was delivered at, recorded apart from the construction receipts. A desired install/publication with no observed read-back stays pending (activation_pending true, achieved_state lower); an installed or published stage is claimed only from an observed read-back bound to this package's pages and location, and never by a package that was not authorized for it. Re-proved at check time by launcher_core/check_rules/activation.py.",
      "required": [
        "desired_state",
        "achieved_state",
        "authority",
        "pending_stage",
        "activation_pending",
        "readback",
        "source",
        "record"
      ],
      "properties": {
        "desired_state": {"$ref": "#/definitions/activation_stage"},
        "achieved_state": {"$ref": "#/definitions/activation_stage"},
        "label": {"type": "string"},
        "authority": {
          "type": ["object", "null"],
          "description": "The recorded authorization that already covers this stage: null for local/draft construction, required for installed (scope installation) and published (scope publication), always for this launch's own location_id.",
          "required": ["ref", "scope", "location_id"],
          "properties": {
            "ref": {"type": "string", "minLength": 1},
            "scope": {"type": "string", "enum": ["installation", "publication"]},
            "location_id": {"type": "string", "minLength": 1}
          }
        },
        "pending_stage": {
          "type": ["string", "null"],
          "enum": ["local_prepared", "draft_constructed", "installed", "published", null]
        },
        "activation_pending": {"type": "boolean"},
        "readback": {
          "type": ["object", "null"],
          "description": "The observed record of an installation or publication: the canonical read route as source, page_id, the https page_url, observed_at, and — published — the live page_type and integer page_version; installed — the observed native install facts. A save click, a draft response or a local 'published' field is not a read-back."
        },
        "source": {"type": ["string", "null"]},
        "record": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "const": "activation.json"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      },
      "additionalProperties": true
    },
    "activation_stage": {
      "type": "string",
      "enum": ["local_prepared", "draft_constructed", "installed", "published"]
    },
    "unit_receipt": {
      "type": "object",
      "required": [
        "unit_id",
        "unit_type",
        "tenant_id",
        "location_id",
        "launch_id",
        "revision",
        "approved_plan_hash",
        "request",
        "artifacts",
        "lane_validation",
        "proof",
        "status"
      ],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "unit_type": {
          "type": "string",
          "enum": ["page", "email", "text", "automation", "conversation_ai"]
        },
        "tenant_id": {"type": "string", "minLength": 1},
        "location_id": {"type": "string", "minLength": 1},
        "launch_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "approved_plan_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "request": {
          "type": "object",
          "required": ["plan_sha256"],
          "properties": {
            "plan_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
            "request_id": {"type": ["string", "null"]},
            "input_hash": {"type": ["string", "null"]}
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256", "size"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "size": {"type": "integer", "minimum": 1},
              "kind": {"type": "string"},
              "provider": {"type": "string"}
            }
          }
        },
        "lane_validation": {
          "type": "object",
          "required": ["lane", "contract", "state"],
          "properties": {
            "lane": {"type": "string", "minLength": 1},
            "contract": {"type": "string", "minLength": 1},
            "state": {"type": "string", "const": "passed"},
            "detail": {"type": "string"},
            "certificate_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "proof": {
          "type": "object",
          "required": ["authored", "draft_installed", "tested", "live_verified"],
          "properties": {
            "authored": {"type": "boolean"},
            "draft_installed": {"type": "boolean"},
            "tested": {"type": "boolean"},
            "live_verified": {"type": "boolean"}
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "authored",
            "draft_delivered",
            "locally_verified",
            "installed_test_verified",
            "ready_for_activation",
            "live_verified"
          ]
        },
        "draft_only": {"type": "boolean"},
        "delivery": {"type": "string", "enum": ["declared"]}
      }
    }
  }
}
