{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Signature Launch offer",
  "properties": {
    "offer_id": {
      "type": "string",
      "minLength": 1
    },
    "slot": {
      "enum": [
        "main",
        "bump",
        "upsell_1",
        "downsell_1",
        "upsell_2"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entitlement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entitlements_removed_vs_u1": {
      "type": "array",
      "description": "Downsell only: the upsell_1 entitlements this offer does not grant, computed by the downsell extension builder from the two offers; never authored.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "native_product_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "production_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "authored",
        "draft_delivered",
        "locally_verified",
        "installed_test_verified",
        "ready_for_activation",
        "live_verified",
        "failed",
        null
      ],
      "description": "Shared-semantics boundary: OFFER IDENTITY (BFL-001). How far this offer's own sellable artifacts (native product, native price, delivery artifact) have actually got. The values are the unit receipt's existing ladder in 83-black-friday-launcher/receipt.schema.json (definitions.unit_receipt.status) plus 'failed', so the package cannot hold two competing vocabularies; 'authored' means the offer is written down only. null or absence means nothing is recorded, and no lane may infer production from the offer being present, from a native id being planned, or from an artifact existing on disk. Only the receipt row that actually proves the state may set it."
    },
    "prices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "title": "Approved price choice",
        "properties": {
          "price_choice_id": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount_minor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "billing_type": {
            "enum": [
              "one_time",
              "recurring",
              "installment",
              "trial"
            ]
          },
          "native_price_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "schedule": {
            "type": "array",
            "items": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "additionalProperties": false,
              "title": "Schedule row",
              "properties": {
                "amount_minor": {
                  "type": "integer",
                  "minimum": 0
                },
                "due": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "amount_minor",
                "due"
              ]
            }
          },
          "terms_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "recurring_interval": {
            "enum": [
              "week",
              "month",
              "quarter",
              "year"
            ],
            "description": "How often a recurring price bills. Present only with billing_type recurring; the interval is material disclosure and is never guessed."
          },
          "approval_status": {
            "enum": [
              "provided",
              "recommended_unapproved",
              "approved",
              "unknown"
            ]
          }
        },
        "required": [
          "price_choice_id",
          "currency",
          "amount_minor",
          "billing_type",
          "native_price_id",
          "schedule",
          "approval_status"
        ],
        "allOf": [
          {
            "description": "A trial or installment price must record the charges that follow the first one; an empty schedule is how a trial got printed as a one-time charge.",
            "if": {
              "properties": {
                "billing_type": {
                  "enum": [
                    "trial",
                    "installment"
                  ]
                }
              },
              "required": [
                "billing_type"
              ]
            },
            "then": {
              "properties": {
                "schedule": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "description": "A recurring price records its charges either as a schedule or as the recurring_interval it bills on; with neither, the cadence is unstated and the price is refused.",
            "if": {
              "properties": {
                "billing_type": {
                  "const": "recurring"
                }
              },
              "required": [
                "billing_type"
              ]
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "recurring_interval"
                  ]
                },
                {
                  "properties": {
                    "schedule": {
                      "minItems": 1
                    }
                  }
                }
              ]
            }
          },
          {
            "description": "Recurrence terms never ride a price that is not recurring.",
            "if": {
              "properties": {
                "billing_type": {
                  "const": "recurring"
                }
              },
              "required": [
                "billing_type"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "recurring_interval"
                ]
              }
            }
          }
        ]
      }
    },
    "source_kind": {
      "enum": [
        "owner",
        "existing_verified_catalog",
        "recommendation",
        "test_fixture"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "test_only": {
      "type": "boolean"
    }
  },
  "required": [
    "offer_id",
    "slot",
    "display_name",
    "deliverables",
    "exclusions",
    "entitlement_ids",
    "requires",
    "excludes",
    "native_product_id",
    "prices",
    "source_kind",
    "source_ref",
    "test_only"
  ]
}
