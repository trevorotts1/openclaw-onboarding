{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Page build request",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "location_id": {
      "type": "string",
      "minLength": 1
    },
    "launch_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "page_id": {
      "type": "string",
      "minLength": 1
    },
    "page_role": {
      "enum": [
        "landing",
        "product_selection",
        "checkout",
        "upsell_1",
        "downsell_1",
        "upsell_2",
        "thank_you"
      ]
    },
    "assigned_skill": {
      "type": "integer"
    },
    "shared_image_service": {
      "const": "71-blackceo-signature-page",
      "description": "Fix 3 shared-service marker: set only by Skill 71 scripts/shared_page_service.py. Present means the four image stages for this page role are produced by Skill 71's shared image service and called from the owning skill's wrapper; absent means scripts/launch_context.py keeps the landing-only refusals."
    },
    "approval_ref": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1
    },
    "brand_ref": {
      "type": "string",
      "minLength": 1
    },
    "brand_hash": {
      "type": "string",
      "minLength": 1
    },
    "route_graph_ref": {
      "type": "string",
      "minLength": 1
    },
    "route_graph_hash": {
      "type": "string",
      "minLength": 1
    },
    "offer_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "copy_profile": {
      "type": "string",
      "minLength": 1
    },
    "prompt_policy_id": {
      "type": "string",
      "minLength": 1,
      "description": "v1.1 (Q12 prompt-policy reconciliation, S49): OPTIONAL name of the governing prompt policy, minted by the common registry only. Stamped by dispatch_launch.build_requests from the launch record's prompt_policy_id (top level beside brand_ref/brand_hash, plan-approved content bound by the plan document hash) when the record names one; when the record names none, dispatch emits 1.0 requests and the key is absent entirely, never null. Consumers must tolerate absence."
    },
    "allowed_write_target": {
      "enum": [
        "local_only",
        "approved_test_location",
        "approved_live_publication"
      ]
    },
    "test_only": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "location_id",
    "launch_id",
    "revision",
    "request_id",
    "page_id",
    "page_role",
    "assigned_skill",
    "approval_ref",
    "input_hash",
    "brand_ref",
    "brand_hash",
    "route_graph_ref",
    "route_graph_hash",
    "offer_refs",
    "copy_profile",
    "allowed_write_target",
    "test_only"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "required": [
          "prompt_policy_id"
        ]
      }
    }
  ]
}
