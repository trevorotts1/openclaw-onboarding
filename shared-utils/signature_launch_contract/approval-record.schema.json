{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Command Center launch approval record (the GET reply approval_record.verify reads)",
  "description": "Minted only by Command Center from the client's own reply carrying the plan-hash prefix. An AI session cannot write it, so a file shaped like this is never an approval.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "approval_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,128}$" },
    "kind": {
      "enum": [
        "launch_plan_build",
        "paid_asset_budget",
        "test_location_use",
        "live_payment_test",
        "customer_send_activation",
        "page_publication",
        "batch_merge",
        "release_publication",
        "fleet_rollout"
      ]
    },
    "plan_hash": { "type": "string", "minLength": 1 },
    "client_identity": { "type": "string", "minLength": 1 },
    "source_message_ref": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "cap": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "cap_minor": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 }
      },
      "required": ["cap_minor", "currency"]
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked": { "type": "boolean" },
    "verification_class": {
      "enum": ["authenticated_platform_record", "recorded_consent_not_cryptographically_sealed"]
    }
  },
  "required": [
    "schema_version",
    "approval_id",
    "kind",
    "plan_hash",
    "client_identity",
    "source_message_ref",
    "scope",
    "expires_at",
    "revoked",
    "verification_class"
  ]
}
