        "course production acceptance",
        "live-course sessions (with Skill 6 Meeting Rooms)"
      ]
    },
    "community-builder": {
      "library_dir": "community-builder",
      "label": "Community Builder",
      "primary_for": [
        "group and channel structure",
        "moderation",
        "member operations",
        "learning association",
        "member experience",
        "community publishing handoff"
      ]
