    "aliases": [
      "Convert and Flow",
      "Convert & Flow",
      "GoHighLevel",
      "GHL"
    ],
    "case_insensitive": true,
    "never_create_department_ids": [
      "ghl",
      "gohighlevel",
      "go-high-level",
      "convert-and-flow",
      "convert-flow",
      "ghl-hybrid"
    ],
    "display_label": "CRM / Convert and Flow",
    "stable_ids_unchanged": [
      "crm",
      "courses",
      "community-builder"
    ]
  },
