      "primary_for": [
        "content calendar",
        "brand-level publishing strategy",
        "approved publishing handoff"
      ]
    },
    "web-development": {
      "library_dir": "web-development",
      "label": "Web Development",
      "primary_for": [
        "page and form delivery",
        "widget placement on a page"
      ]
    },
    "funnels": {
      "library_dir": "funnels",
      "label": "Funnels",
      "primary_for": [
        "funnel build and pre-ship QA"
      ]
    },
    "sales": {
      "library_dir": "sales",
      "label": "Sales",
      "primary_for": [
        "lead follow-up and closing"
      ]
    }
